# Sin la barra final: en un worktree, `node_modules` es un ENLACE al del
# checkout principal, y `node_modules/` (con barra) solo casa con
# directorios. Por eso un `git add -A` llego a versionar el enlace.
node_modules
dist/
.firebase/
.firebaserc
*.local
*.local.*
.env
.env.*
!.env.example
firebase-debug.log
firestore-debug.log
ui-debug.log
storage-debug.log
# Configuración temporal de pruebas/correr-storage.sh (se borra al salir).
pruebas/.emu-storage.*/
coverage/
*.tsbuildinfo
