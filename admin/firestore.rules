rules_version = '2';

// =============================================================================
// NovuChat — Panel administrativo multi-tenant
// Reglas de seguridad de Cloud Firestore
// =============================================================================
//
// PRINCIPIOS (el porqué, no solo el cómo — ver admin/SEGURIDAD.md):
//
//  1. NEGAR POR DEFECTO. No existe ninguna regla comodín que permita. La última
//     coincidencia de este archivo deniega todo lo que no se habilitó arriba de
//     forma explícita. Una colección nueva nace inaccesible.
//
//  2. EL TENANT VIVE EN LA RUTA, NUNCA EN UN CAMPO. Todo dato de un negocio
//     cuelga de /tenants/{tenantId}/... El identificador del tenant que la regla
//     compara sale del *path* de la petición y del *token*: jamás del cuerpo del
//     documento ni de un parámetro que el cliente pueda elegir.
//
//  3. LA PERTENENCIA Y EL ROL VIVEN EN CUSTOM CLAIMS. Los emite exclusivamente
//     una Cloud Function con el SDK Admin. El navegador no puede escribirlos ni
//     falsificarlos: van firmados dentro del ID token por Google.
//     El documento /tenants/{t}/miembros/{uid} es un ESPEJO para pintar la
//     interfaz; no otorga ningún permiso y es de solo lectura para todos.
//
//  4. MÍNIMO PRIVILEGIO. El propietario de NovuChat administra tenants pero NO
//     lee conversaciones de clientes salvo con un permiso de soporte explícito,
//     otorgado por el negocio y con vencimiento.
//
//  5. LAS REGLAS DE FIRESTORE NO FILTRAN RESULTADOS. Una consulta se permite o
//     se rechaza entera. Por eso el aislamiento se apoya en la ruta: una consulta
//     que no está anclada bajo el tenant del token simplemente falla.
//
//  6. LAS REGLAS NO PUEDEN OCULTAR CAMPOS SUELTOS EN LECTURA. Lo que un rol no
//     debe ver va en OTRO documento, no en otro campo. Por eso los datos
//     personales ampliados del contacto viven en .../conversaciones/{c}/privado.
//
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Ayudantes de identidad
    // -------------------------------------------------------------------------

    // Espacio de nombres corto `nc` dentro de los custom claims. Los custom
    // claims tienen un tope duro de 1000 bytes: las claves cortas son lo que
    // permite que un usuario pertenezca a varios negocios sin reventarlo.
    //
    // Forma: { nc: { p: true, t: { "<tenantId>": "admin" | "oper" | "ingesta" }, v: 3 } }
    //   p → propietario de plataforma (NovuChat)
    //   t → mapa tenantId -> rol
    //   v → versión de claims, para forzar refresco del token desde el cliente
    function autenticado() {
      return request.auth != null && request.auth.uid != null;
    }

    function nc() {
      return request.auth.token.get('nc', {});
    }

    // Propietario de NovuChat. NO implica acceso a conversaciones (ver punto 4).
    // -------------------------------------------------------------------------
    // VÍNCULO ROL ↔ PROVEEDOR DE IDENTIDAD
    //
    // Regla de seguridad, no preferencia:
    //   superadministrador de NovuChat  →  SOLO cuenta de Google
    //   administrador / operador de un comercio  →  SOLO usuario y contraseña
    //   principal de ingesta (n8n)  →  SOLO token personalizado
    //
    // `firebase.sign_in_provider` viaja DENTRO del ID token firmado por Google:
    // dice con qué proveedor se abrió ESTA sesión y el cliente no lo puede
    // alterar. Al meterlo dentro de los predicados base —y no en cada `allow`—
    // el vínculo se vuelve imposible de eludir por olvido: toda regla del
    // archivo pasa por `esPropietario`, `esAdmin`, `esOperador` o `esIngesta`.
    //
    // EFECTO: un claim mal puesto queda INERTE. Si por un error operativo o un
    // fallo en una Function un administrador de comercio recibiera `p: true`,
    // su sesión de contraseña nunca satisface `proveedor() == 'google.com'` y no
    // obtiene nada. El claim solo se activa desde una sesión de Google, que es
    // la que protege el segundo factor de la cuenta de Andres o de Silvana.
    // Ver SEGURIDAD.md, amenaza T-19.
    // -------------------------------------------------------------------------
    function proveedor() {
      return request.auth.token.get('firebase', {}).get('sign_in_provider', '');
    }

    // Correo verificado. Con Google siempre es verdadero; con contraseña es falso
    // hasta que la persona hace clic en el enlace. Exigirlo acá convierte la
    // verificación de correo en un control REAL —el servidor niega los datos—
    // y no en un aviso de la interfaz que se saltea recargando la página.
    function correoVerificado() {
      return request.auth.token.get('email_verified', false) == true;
    }

    function esPropietario() {
      return autenticado()
        && nc().get('p', false) == true
        && proveedor() == 'google.com';
    }

    // Rol del usuario EN ESTE tenant, o cadena vacía. `tenantId` viene siempre
    // del path, nunca de un dato que el cliente pueda elegir.
    //
    // EL DEFECTO QUE SE ARREGLÓ ACÁ. Antes esta función devolvía `null` cuando el
    // usuario no tenía rol en el tenant. Comparar `null == 'admin'` no da falso
    // en el lenguaje de reglas: lanza *Null value error*, que deniega la
    // operación por error de evaluación en vez de por la condición. El efecto
    // real era que el propietario de NovuChat NO podía leer `/auditoria`,
    // `/invitaciones` ni `/accesosSoporte` —todas reglas de la forma
    // `esAdmin(t) || esPropietario()`, donde `esAdmin` se evalúa primero y
    // reventaba antes de llegar a la segunda rama—. Con la cadena vacía como
    // valor por defecto, la comparación es siempre entre cadenas y da falso
    // limpio. Lo destapó la prueba de contactos del propietario.
    function rolEn(tenantId) {
      return nc().get('t', {}).get(tenantId, '');
    }

    // Se compone de los predicados de arriba para HEREDAR el vínculo con el
    // proveedor. Si se definiera otra vez a partir de `rolEn`, sería el agujero
    // por el que se cuela todo: un rol sin proveedor comprobado.
    function esMiembro(tenantId) {
      return esPersonaDelNegocio(tenantId) || esIngesta(tenantId);
    }

    // Las personas del comercio entran SOLO con usuario y contraseña, y solo con
    // el correo ya verificado.
    function esAdmin(tenantId) {
      return autenticado()
        && rolEn(tenantId) == 'admin'
        && proveedor() == 'password'
        && correoVerificado();
    }

    function esOperador(tenantId) {
      return autenticado()
        && rolEn(tenantId) == 'oper'
        && proveedor() == 'password'
        && correoVerificado();
    }

    // Principal de servicio de n8n, acotado a UN tenant. Se obtiene con un token
    // efímero (1 h) que emite la Cloud Function de intercambio; n8n nunca guarda
    // una clave de cuenta de servicio con alcance de proyecto.
    // El principal de servicio llega con un token personalizado emitido por la
    // Cloud Function tras validar la firma HMAC. Atarlo a `custom` impide que
    // una persona —con Google o con contraseña— use un claim de ingesta para
    // escribir en el historial de conversaciones, que es inmutable justamente
    // para que sirva como evidencia.
    function esIngesta(tenantId) {
      return autenticado()
        && rolEn(tenantId) == 'ingesta'
        && proveedor() == 'custom';
    }

    // Persona (admin u operador). Excluye al principal de servicio, que es
    // ciego por diseño: escribe conversaciones y no puede leerlas.
    function esPersonaDelNegocio(tenantId) {
      return esAdmin(tenantId) || esOperador(tenantId);
    }

    // -------------------------------------------------------------------------
    // Ayudantes de estado (cuestan una lectura documental cada uno)
    // -------------------------------------------------------------------------

    // ESTADOS DE UN COMERCIO — la palanca comercial de NovuChat.
    //
    //   'activo'        opera con normalidad.
    //   'suspendido'    palanca por falta de pago. El asistente DEJA de atender
    //                   a los clientes finales y el comercio deja de poder
    //                   editar nada, pero SIGUE VIENDO SUS DATOS. Reversible al
    //                   instante y sin tocar los claims.
    //   'dado_de_baja'  fin de contrato. Ni lectura ni escritura desde el panel.
    //
    // Consultar el estado en cada operación cuesta UNA lectura documental (que
    // además se cachea dentro de la misma petición) y compra algo que no se
    // puede comprar de otro modo: EFECTO INMEDIATO. Un ID token vive hasta una
    // hora; si la suspensión dependiera de los claims, el comercio seguiría
    // operando durante todo ese rato después de que se le cortó el servicio.
    // Para una palanca de cobranza, una hora de retraso la vuelve inútil.
    function estadoTenant(tenantId) {
      return exists(/databases/$(database)/documents/tenants/$(tenantId))
        ? get(/databases/$(database)/documents/tenants/$(tenantId)).data.get('estado', '')
        : '';
    }

    // Habilita ESCRITURA y la ingesta desde n8n. Solo 'activo'.
    function tenantOperativo(tenantId) {
      return estadoTenant(tenantId) == 'activo';
    }

    // Habilita LECTURA en el panel. Un comercio suspendido sigue viendo lo suyo:
    // son sus datos, y cortarle la vista no ayuda a cobrarle — le quita la
    // manera de verificar lo que se le factura.
    function tenantLegible(tenantId) {
      return estadoTenant(tenantId) in ['activo', 'suspendido'];
    }

    // Acceso de soporte: el propietario de NovuChat solo lee conversaciones si
    // el negocio le concedió una ventana con vencimiento. La concesión la crea
    // una Cloud Function a pedido de un admin del negocio y queda auditada.
    function soporteVigente(tenantId) {
      return esPropietario()
        && exists(/databases/$(database)/documents/tenants/$(tenantId)/accesosSoporte/$(request.auth.uid))
        && get(/databases/$(database)/documents/tenants/$(tenantId)/accesosSoporte/$(request.auth.uid))
             .data.get('expira', request.time) > request.time;
    }

    function puedeLeerConversaciones(tenantId) {
      return (esPersonaDelNegocio(tenantId) && tenantLegible(tenantId))
        || soporteVigente(tenantId);
    }

    // -------------------------------------------------------------------------
    // Ayudantes de validación
    // -------------------------------------------------------------------------

    function soloCampos(permitidos) {
      return resource != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(permitidos);
    }

    // NOTA IMPORTANTE SOBRE EL ESTILO DE ESTAS VALIDACIONES
    // -----------------------------------------------------
    // En el lenguaje de reglas, leer una clave ausente de un mapa (`d.campo`)
    // NO devuelve nulo: lanza un error de evaluación. Un error de evaluación
    // deniega la operación, así que "parece" seguro, pero deniega por el motivo
    // equivocado: la misma expresión puede tumbar una escritura legítima y deja
    // ruido de diagnóstico imposible de leer. Por eso acá TODO acceso a campos
    // usa `d.get(clave, valorPorDefecto)`, que sí devuelve el valor por defecto
    // cuando la clave falta. El valor por defecto se elige de modo que un campo
    // opcional ausente PASE la validación y uno obligatorio ausente la falle.

    function cadena(valor, maxLargo) {
      return valor is string && valor.size() <= maxLargo;
    }

    // Campo obligatorio de texto, no vacío.
    function textoReq(datos, campo, maxLargo) {
      return cadena(datos.get(campo, null), maxLargo)
        && datos.get(campo, '').size() > 0;
    }

    // Campo opcional de texto: ausente equivale a cadena vacía y pasa.
    function textoOpc(datos, campo, maxLargo) {
      return cadena(datos.get(campo, ''), maxLargo);
    }

    // Sello de auditoría: quien escribe no puede mentir sobre quién es ni sobre
    // cuándo escribió. Sin esto, la pista de auditoría es decorativa.
    function selloValido(datos) {
      return datos.get('actualizadoPor', '') == request.auth.uid
        && datos.get('actualizadoEn', null) == request.time;
    }

    // =========================================================================
    // /tenants/{tenantId} — ficha del negocio
    // =========================================================================
    match /tenants/{tenantId} {

      // `get` puntual: miembros del propio tenant y el propietario de NovuChat.
      allow get: if esMiembro(tenantId) || esPropietario();

      // `list` (consulta sobre la colección): SOLO el propietario. Sin esta
      // separación, cualquier usuario autenticado podría enumerar la cartera
      // completa de clientes de NovuChat, que es información comercial sensible
      // aunque no incluya conversaciones.
      allow list: if esPropietario();

      // Alta, baja y cambio de plan pasan SIEMPRE por Cloud Functions con el SDK
      // Admin, que además emiten los custom claims, escriben la auditoría e
      // impiden reutilizar un tenantId dado de baja. Ningún navegador escribe acá.
      allow create, update, delete: if false;

      // -----------------------------------------------------------------------
      // /config/{documento} — la configuración que hoy vive en el nodo
      // `Config del negocio` de los flujos de n8n.
      // -----------------------------------------------------------------------
      match /config/{documento} {

        allow get, list: if esMiembro(tenantId);

        // Solo el admin del negocio edita la configuración, y solo el documento
        // `negocio`. La creación y el borrado los hace la Function de alta/baja:
        // así el documento nunca queda a medio formar ni desaparece por error.
        allow update: if esAdmin(tenantId)
                      && tenantOperativo(tenantId)
                      && documento == 'negocio'
                      && configNegocioValida();
        allow create, delete: if false;

        // Validación de esquema. Esto NO es cosmética: el contenido de este
        // documento termina inyectado en el prompt del agente de n8n. Sin límite
        // de longitud ni lista blanca de claves, un admin del negocio (o un XSS
        // en su sesión) podría inyectar instrucciones arbitrarias al modelo:
        // inyección de prompt de segundo orden.
        //
        // El PROMPT BASE del agente NO es editable desde el panel: vive en el
        // flujo de n8n. Acá solo se admiten datos, y `instruccionesExtra` entra
        // al prompt delimitada y rotulada como dato, nunca como instrucción.
        function configNegocioValida() {
          let d = request.resource.data;
          return d.keys().hasOnly([
                   'nombreNegocio', 'descripcion', 'zonaHoraria', 'telefonoRecepcion',
                   'calendarioId', 'horarios', 'mensajes', 'instruccionesExtra',
                   'moneda', 'actualizadoPor', 'actualizadoEn'
                 ])
            && textoReq(d, 'nombreNegocio', 80)
            && textoOpc(d, 'descripcion', 400)
            // Zona horaria de una lista cerrada: evita valores que rompan el
            // cálculo de "mañana a las 3" en el agente.
            && d.get('zonaHoraria', 'America/La_Paz') in ['America/La_Paz']
            // Teléfono en formato E.164 sin '+', igual que lo espera la Cloud API.
            && d.get('telefonoRecepcion', '59100000000') is string
            && d.get('telefonoRecepcion', '59100000000').matches('^[0-9]{8,15}$')
            && textoOpc(d, 'calendarioId', 120)
            && d.get('moneda', 'BOB') in ['BOB', 'USD']
            && d.get('horarios', {}) is map
            && d.get('mensajes', {}) is map
            // Tope duro del texto libre que llega al modelo.
            && textoOpc(d, 'instruccionesExtra', 1500)
            && selloValido(d);
        }
      }

      // -----------------------------------------------------------------------
      // /catalogo/{itemId} — productos o servicios con precio.
      // Va en subcolección, no como lista dentro de config, para que cada ítem
      // se pueda validar de verdad: las reglas no saben recorrer listas de mapas.
      // -----------------------------------------------------------------------
      match /catalogo/{itemId} {

        allow get, list: if esMiembro(tenantId);

        allow create, update: if esAdmin(tenantId)
                              && tenantOperativo(tenantId)
                              && itemValido();
        allow delete: if esAdmin(tenantId) && tenantOperativo(tenantId);

        function itemValido() {
          let d = request.resource.data;
          return d.keys().hasOnly([
                   'nombre', 'descripcion', 'precio', 'moneda', 'duracionMin',
                   'activo', 'actualizadoPor', 'actualizadoEn'
                 ])
            && textoReq(d, 'nombre', 80)
            && textoOpc(d, 'descripcion', 300)
            // Número y no negativo: un precio negativo llega al agente y al
            // cliente final como una promesa que el negocio no quiso hacer.
            && d.get('precio', null) is number
            && d.get('precio', -1) >= 0 && d.get('precio', -1) <= 1000000
            && d.get('moneda', '') in ['BOB', 'USD']
            && d.get('duracionMin', 30) is int
            && d.get('duracionMin', 30) > 0 && d.get('duracionMin', 30) <= 1440
            && d.get('activo', null) is bool
            && selloValido(d);
        }
      }

      // -----------------------------------------------------------------------
      // /contactos/{contactoId} — PERSONAS DE REFERENCIA DEL COMERCIO.
      //
      // No confundir con /miembros: aquéllos son usuarios DEL PANEL. Éstos son
      // las personas de contacto del negocio —el dueño, quien atiende recepción,
      // quien factura— que en general NO tienen acceso al panel y que muchas
      // veces ni saben que están anotadas acá.
      //
      // Son DATOS PERSONALES DE TERCEROS y se les aplica el mismo criterio que a
      // /conversaciones/{c}/privado: como las reglas de Firestore no pueden
      // ocultar campos sueltos en una lectura, lo que un rol no debe ver va en
      // OTRA colección. Por eso viven acá y no como campos de la ficha del
      // tenant, que la leen todos los miembros.
      //
      // QUIÉN ENTRA:
      //   admin del negocio  → todo. Es su agenda.
      //   operador           → NADA. Atender conversaciones no requiere el
      //                        teléfono del contador del negocio. Mínimo
      //                        privilegio, sin excepción cómoda.
      //   NovuChat           → SOLO los marcados `esContactoComercial`. Es a
      //                        quién llamar por la factura, y nada más. Para el
      //                        resto necesita acceso de soporte vigente, igual
      //                        que para las conversaciones.
      //
      // ⚠️ SOBRE `list` Y EL FILTRO: en Firestore las reglas NO filtran
      // resultados. Para que el propietario pueda listar, su consulta tiene que
      // traer `where('esContactoComercial','==',true)`; si no lo trae, la
      // consulta falla ENTERA. Eso es correcto y deliberado: el modo de fallar
      // es negar, nunca devolver de más. El `get` puntual de un contacto
      // comercial sí funciona sin ninguna condición extra.
      // -----------------------------------------------------------------------
      match /contactos/{contactoId} {

        allow get, list: if (esAdmin(tenantId) && tenantLegible(tenantId))
                         || soporteVigente(tenantId)
                         || (esPropietario()
                             && resource.data.get('esContactoComercial', false) == true);

        allow create, update: if esAdmin(tenantId)
                              && tenantOperativo(tenantId)
                              && contactoValido();
        allow delete: if esAdmin(tenantId) && tenantOperativo(tenantId);

        function contactoValido() {
          let d = request.resource.data;
          return d.keys().hasOnly([
                   'nombre', 'rolNegocio', 'telefono', 'correo', 'notas',
                   'esContactoComercial', 'actualizadoPor', 'actualizadoEn'
                 ])
            && textoReq(d, 'nombre', 120)
            // Lista cerrada de roles: evita que este campo se convierta en un
            // texto libre más donde acabe cayendo información que nadie previó.
            && d.get('rolNegocio', '') in ['dueno', 'recepcion', 'facturacion',
                                           'tecnico', 'otro']
            && d.get('telefono', '') is string
            && d.get('telefono', '').matches('^[0-9]{8,15}$')
            && textoOpc(d, 'correo', 254)
            // Tope corto en las notas: este campo NO es una ficha clínica ni un
            // historial. Cuanto menos dato personal de terceros se acumule, menor
            // es el daño de cualquier fuga.
            && textoOpc(d, 'notas', 500)
            && d.get('esContactoComercial', false) is bool
            && selloValido(d);
        }
      }

      // -----------------------------------------------------------------------
      // /cuenta/estado — ESTADO DE CUENTA, VISIBLE PARA EL COMERCIO.
      //
      // Plan, situación de pago y próximo vencimiento. El comercio necesita
      // poder responder solo la pregunta "¿estoy al día?" sin llamar a nadie.
      //
      // ES DE SOLO LECTURA PARA ÉL. Cambiarlo es de NovuChat, por Cloud
      // Function, y queda auditado. Si el comercio pudiera escribirlo, se
      // pondría `al_dia` y el estado de cuenta dejaría de significar nada.
      //
      // SE LEE CON `tenantLegible`, NO CON `tenantOperativo`: es JUSTAMENTE
      // cuando el comercio está suspendido cuando más necesita ver esta
      // pantalla. Un corte de servicio sin explicación visible es una llamada
      // de reclamo garantizada.
      //
      // DOS PÚBLICOS DISTINTOS, NO CONFUNDIRLOS:
      //   `motivoVisible`     → lo lee el COMERCIO. Explica su situación. Es su
      //                         relación comercial y tiene derecho a conocerla.
      //   `motivoSuspension`  → campo de la ficha del tenant, INTERNO, para la
      //                         auditoría de NovuChat.
      // Y ninguno de los dos llega jamás al CLIENTE FINAL de WhatsApp, que
      // recibe un mensaje de cortesía neutro (ver DISENO.md §4bis.3 y T-18).
      //
      // El operador queda afuera: la situación financiera del negocio no es
      // asunto de quien atiende el chat.
      // -----------------------------------------------------------------------
      match /cuenta/{documento} {
        allow get, list: if (esAdmin(tenantId) && tenantLegible(tenantId))
                         || esPropietario();
        allow create, update, delete: if false;
      }

      // -----------------------------------------------------------------------
      // /reclamos/{reclamoId} — RECLAMOS DEL COMERCIO HACIA NOVUCHAT.
      //
      // Se guardan en Firestore ANTES de enviarse por correo. Si el proveedor de
      // correo falla, el reclamo no se pierde: queda acá y se ve en el panel de
      // NovuChat igual. El correo es una notificación, no el registro.
      //
      // INMUTABLES para el cliente. El comercio crea y lee; no edita ni borra.
      // Un reclamo que se puede editar después de enviado no sirve para dirimir
      // nada, y uno que se puede borrar tampoco.
      //
      // El campo `texto` es ENTRADA NO CONFIABLE aunque lo escriba un usuario
      // autenticado: se muestra en el panel y viaja en un correo. Ver T-20.
      // -----------------------------------------------------------------------
      match /reclamos/{reclamoId} {

        allow get, list: if (esPersonaDelNegocio(tenantId) && tenantLegible(tenantId))
                         || esPropietario();

        // Un comercio suspendido SÍ puede reclamar. Sería absurdo cortarle el
        // canal de reclamo justo cuando tiene el motivo más probable para usarlo.
        allow create: if esPersonaDelNegocio(tenantId)
                      && tenantLegible(tenantId)
                      && reclamoValido();

        // Ni el comercio ni NovuChat lo tocan desde el navegador. El cambio de
        // estado (nuevo → en_curso → resuelto) lo hace una Cloud Function, que
        // además audita quién lo movió.
        allow update, delete: if false;

        function reclamoValido() {
          let d = request.resource.data;
          return d.keys().hasOnly([
                   'asunto', 'texto', 'categoria', 'estado',
                   'creadoPor', 'creadoEn', 'correoNotificado'
                 ])
            && textoReq(d, 'asunto', 120)
            && textoReq(d, 'texto', 4000)
            && d.get('categoria', '') in ['facturacion', 'falla', 'configuracion',
                                          'sugerencia', 'otro']
            // El estado nace SIEMPRE en 'nuevo'. Que el cliente pudiera crearlo
            // como 'resuelto' vaciaría de sentido la bandeja de NovuChat.
            && d.get('estado', '') == 'nuevo'
            // Sello: quien reclama no puede reclamar en nombre de otro ni
            // antedatar el reclamo.
            && d.get('creadoPor', '') == request.auth.uid
            && d.get('creadoEn', null) == request.time
            // La marca de correo enviado la pone la Function, nunca el cliente.
            && !d.keys().hasAny(['correoNotificado']);
        }
      }

      // -----------------------------------------------------------------------
      // /miembros/{uid} — espejo de los custom claims, para la interfaz.
      // NO otorga permisos. Es de solo lectura para TODOS los clientes: si fuera
      // escribible, la interfaz mostraría un rol falso y, peor, el patrón
      // invitaría a que alguien lo usara como fuente de autorización.
      // -----------------------------------------------------------------------
      match /miembros/{uid} {
        allow get, list: if esMiembro(tenantId) || esPropietario();
        allow create, update, delete: if false;
      }

      // -----------------------------------------------------------------------
      // /invitaciones/{invitacionId} — alta de usuarios del negocio.
      // El token de invitación NO se guarda en claro: se guarda su hash. Quien
      // lea esta colección no puede aceptar invitaciones ajenas.
      // -----------------------------------------------------------------------
      match /invitaciones/{invitacionId} {
        allow get, list: if esAdmin(tenantId) || esPropietario();
        allow create, update, delete: if false;
      }

      // -----------------------------------------------------------------------
      // /conversaciones/{conversacionId} — visor de conversaciones.
      // Es el dato más sensible del sistema: mensajes de clientes finales.
      // -----------------------------------------------------------------------
      match /conversaciones/{conversacionId} {

        allow get, list: if puedeLeerConversaciones(tenantId);

        // Alta y actualización del hilo: solo el principal de servicio de n8n,
        // acotado a ESTE tenant por su claim. Un token de ingesta del tenant A
        // no satisface `esIngesta(B)`.
        //
        // `tenantOperativo` acá tiene un efecto que conviene entender: cuando se
        // suspende un comercio por falta de pago, la ingesta se cierra y NovuChat
        // deja de acumular datos personales de clientes finales de un comercio
        // que ya no presta el servicio. No es solo una palanca de cobranza: es
        // minimización de datos.
        allow create: if esIngesta(tenantId)
                      && tenantOperativo(tenantId)
                      && conversacionValida();
        allow delete: if false;

        // Dos ramas de actualización disjuntas:
        //  a) n8n actualiza el resumen del hilo;
        //  b) una persona del negocio marca gestión interna, y SOLO puede tocar
        //     los tres campos de gestión. Sin `hasOnly`, un operador podría
        //     reescribir `ultimoMensaje` o `telefono` y falsear el historial.
        allow update: if (esIngesta(tenantId) && tenantOperativo(tenantId)
                          && conversacionValida())
                      || (esPersonaDelNegocio(tenantId)
                          && tenantOperativo(tenantId)
                          && soloCampos(['etiquetas', 'atendidaPor', 'notaInterna'])
                          && textoOpc(request.resource.data, 'notaInterna', 1000));

        function conversacionValida() {
          let d = request.resource.data;
          return d.keys().hasOnly([
                   'telefono', 'nombreContacto', 'ultimoMensaje', 'ultimoEn',
                   'canal', 'mensajesTotal', 'etiquetas', 'atendidaPor',
                   'notaInterna',
                   // Marca del último período en que esta persona ya fue contada
                   // como "atendida" (formato 'aaaa-mm'). La escribe SOLO la
                   // ingesta; no está en la lista de campos de gestión, así que
                   // ninguna persona del negocio puede tocarla para inflar la
                   // métrica que se le factura.
                   'periodoContado'
                 ])
            && d.get('telefono', '') is string
            && d.get('telefono', '').matches('^[0-9]{8,15}$')
            && textoOpc(d, 'nombreContacto', 120)
            // El resumen se recorta en origen: un mensaje entrante de 4 KB no
            // debe poder inflar cada documento del listado.
            && textoOpc(d, 'ultimoMensaje', 300)
            && d.get('canal', '') in ['whatsapp'];
        }

        // ---------------------------------------------------------------------
        // /mensajes/{mensajeId} — el registro conversacional.
        // INMUTABLE: se crea y no se modifica ni se borra. Un historial que se
        // puede editar no sirve como evidencia ante un reclamo del cliente.
        // ---------------------------------------------------------------------
        match /mensajes/{mensajeId} {
          allow get, list: if puedeLeerConversaciones(tenantId);
          allow create: if esIngesta(tenantId)
                        && tenantOperativo(tenantId)
                        && mensajeValido();
          allow update, delete: if false;

          function mensajeValido() {
            let d = request.resource.data;
            return d.keys().hasOnly(['direccion', 'tipo', 'texto', 'ts', 'idMeta'])
              && d.get('direccion', '') in ['entrante', 'saliente']
              && d.get('tipo', '') in ['text', 'interactive', 'image', 'audio',
                                       'document', 'order', 'location', 'otro']
              // Tope de tamaño del texto. El contenido es DATO NO CONFIABLE:
              // lo escribe un cliente final de WhatsApp. Se guarda tal cual y se
              // escapa al renderizar (ver admin/SEGURIDAD.md, §Regla de Dos).
              && cadena(d.get('texto', null), 4096)
              && d.get('ts', null) is timestamp
              && textoOpc(d, 'idMeta', 120);
          }
        }

        // ---------------------------------------------------------------------
        // /privado/{documento} — datos personales ampliados del contacto.
        // Vive aparte porque las reglas NO pueden ocultar campos sueltos en una
        // lectura: si el dato estuviera en el documento de la conversación,
        // cualquiera que pueda leerla lo vería. Solo el admin del negocio entra.
        // ---------------------------------------------------------------------
        match /privado/{documento} {
          allow get, list: if esAdmin(tenantId) && tenantLegible(tenantId);
          allow create, update: if esIngesta(tenantId) && tenantOperativo(tenantId);
          allow delete: if false;
        }
      }

      // -----------------------------------------------------------------------
      // /metricas/{periodo} — contadores agregados (uno por mes: '2026-09').
      // Los agrega la ruta de ingesta con incrementos atómicos. El panel LEE
      // agregados en vez de contar conversaciones en el cliente: así el visor de
      // métricas no necesita permiso de lectura sobre los mensajes.
      // -----------------------------------------------------------------------
      match /metricas/{periodo} {
        allow get, list: if esMiembro(tenantId) || esPropietario();
        allow create, update: if esIngesta(tenantId)
                              && tenantOperativo(tenantId)
                              && metricaValida();
        allow delete: if false;

        // Lista blanca también acá: si el principal de ingesta quedara
        // comprometido, no debe poder sembrar campos arbitrarios en la colección
        // que sostiene la facturación.
        function metricaValida() {
          return request.resource.data.keys().hasOnly([
            'mensajes', 'entrantes', 'salientes',
            'personasAtendidas',   // conteo de ÚNICOS, no un incremento por mensaje
            'citasAgendadas', 'conversaciones'
          ]);
        }
      }

      // -----------------------------------------------------------------------
      // /auditoria/{eventoId} — quién cambió qué y cuándo.
      // Solo escribe el SDK Admin (que se salta estas reglas por diseño).
      // Denegar la escritura acá impide que alguien fabrique o borre evidencia.
      // -----------------------------------------------------------------------
      match /auditoria/{eventoId} {
        allow get, list: if esAdmin(tenantId) || esPropietario();
        allow create, update, delete: if false;
      }

      // -----------------------------------------------------------------------
      // /accesosSoporte/{uid} — ventanas de acceso de NovuChat al negocio.
      // Las otorga una Cloud Function a pedido de un admin del negocio. Que sean
      // de solo lectura evita que el propietario se auto-conceda acceso desde el
      // navegador: tiene que pasar por la Function, que lo audita.
      // -----------------------------------------------------------------------
      match /accesosSoporte/{uid} {
        allow get, list: if esAdmin(tenantId) || esPropietario();
        allow create, update, delete: if false;
      }
    }

    // =========================================================================
    // /plataforma/{documento} — configuración de NovuChat, no de ningún comercio.
    //
    // Hoy guarda `notificaciones.correosReclamos`: a qué casillas se avisa
    // cuando entra un reclamo. Es configurable, y por eso mismo es delicado.
    //
    // POR QUÉ NADIE LO ESCRIBE DESDE EL NAVEGADOR. Esta lista es el DESTINO de
    // un correo que lleva texto escrito por un usuario. Si alguien pudiera
    // agregarle una dirección, convertiría el sistema en un reenviador: escribe
    // un reclamo con lo que quiera y lo hace salir, firmado por NovuChat, hacia
    // donde quiera. La escribe solo una Cloud Function, y la Function que envía
    // el correo la lee con el SDK Admin. El destino NUNCA sale del reclamo.
    // =========================================================================
    match /plataforma/{documento} {
      allow get, list: if esPropietario();
      allow create, update, delete: if false;
    }

    // =========================================================================
    // /rutasWhatsApp/{phoneNumberId} — ÍNDICE INVERSO NÚMERO → COMERCIO.
    //
    // POR QUÉ EXISTE
    // --------------
    // El webhook de Meta no trae el identificador del comercio: trae
    // `entry[0].changes[0].value.metadata.phone_number_id`. Con varios flujos
    // (agendamiento, venta y cobro, interno) y un número por comercio, n8n
    // necesita resolver ese número a un tenant y a un flujo antes de hacer
    // cualquier otra cosa.
    //
    // POR QUÉ UNA COLECCIÓN Y NO UNA CONSULTA SOBRE /tenants
    // ------------------------------------------------------
    // Un `where('waPhoneNumberId','==',id)` sobre /tenants exigiría permiso de
    // listado sobre la cartera entera de clientes —justo lo que T-12 prohíbe— y
    // además un índice compuesto. Acá el identificador del número ES la clave
    // del documento: la resolución es una lectura directa, sin índice y sin
    // abrir ningún listado.
    //
    // QUIÉN ENTRA
    // -----------
    // Nadie desde el navegador salvo el propietario de NovuChat. n8n NO lee esta
    // colección: la consulta la hace la Cloud Function con el SDK Admin, después
    // de validar la firma HMAC. Que un comercio pudiera leerla le diría con qué
    // números operan los demás.
    //
    // Documento: { tenantId, flujo, wabaId, estado }
    // =========================================================================
    match /rutasWhatsApp/{phoneNumberId} {
      allow get, list: if esPropietario();
      // La escribe únicamente la Function `asignarNumero`, que además garantiza
      // que un mismo phone_number_id no apunte nunca a dos comercios.
      allow create, update, delete: if false;
    }

    // =========================================================================
    // /usuarios/{uid} — perfil propio. NO contiene roles: los roles son claims.
    // =========================================================================
    match /usuarios/{uid} {
      allow get: if autenticado() && (request.auth.uid == uid || esPropietario());
      allow list: if esPropietario();

      // El usuario edita su propio nombre y preferencias, nada más. La lista
      // blanca de campos es lo que impide la escalada de privilegios clásica:
      // el usuario agregándose a sí mismo un campo `rol: "admin"` con la
      // esperanza de que alguna pantalla lo tome como autorización.
      allow update: if autenticado()
                    && request.auth.uid == uid
                    && soloCampos(['nombre', 'preferencias'])
                    && textoOpc(request.resource.data, 'nombre', 120);
      allow create, delete: if false;
    }

    // =========================================================================
    // NEGACIÓN FINAL. Todo lo que no coincidió con una regla de arriba queda
    // prohibido: colecciones nuevas, rutas mal escritas, experimentos olvidados.
    // Esta regla es la red de seguridad del diseño entero. No borrarla.
    // =========================================================================
    match /{documento=**} {
      allow read, write: if false;
    }
  }
}
