rules_version = '2';

// =============================================================================
// NovuChat — Panel administrativo multi-tenant
// Reglas de seguridad de Cloud Firestore
// =============================================================================
//
// PRINCIPIOS (el porqué, no solo el cómo — ver admin/SEGURIDAD.md):
//
//  1. NEGAR POR DEFECTO. No existe ninguna regla comodín que permita. La última
//     coincidencia de este archivo deniega todo lo que no se habilitó arriba de
//     forma explícita. Una colección nueva nace inaccesible.
//
//  2. EL TENANT VIVE EN LA RUTA, NUNCA EN UN CAMPO. Todo dato de un negocio
//     cuelga de /tenants/{tenantId}/... El identificador del tenant que la regla
//     compara sale del *path* de la petición y del *token*: jamás del cuerpo del
//     documento ni de un parámetro que el cliente pueda elegir.
//
//  3. LA PERTENENCIA Y EL ROL VIVEN EN CUSTOM CLAIMS. Los emite exclusivamente
//     una Cloud Function con el SDK Admin. El navegador no puede escribirlos ni
//     falsificarlos: van firmados dentro del ID token por Google.
//     El documento /tenants/{t}/miembros/{uid} es un ESPEJO para pintar la
//     interfaz; no otorga ningún permiso y es de solo lectura para todos.
//
//  4. MÍNIMO PRIVILEGIO. El propietario de NovuChat administra tenants pero NO
//     lee conversaciones de clientes salvo con un permiso de soporte explícito,
//     otorgado por el negocio y con vencimiento.
//
//  5. LAS REGLAS DE FIRESTORE NO FILTRAN RESULTADOS. Una consulta se permite o
//     se rechaza entera. Por eso el aislamiento se apoya en la ruta: una consulta
//     que no está anclada bajo el tenant del token simplemente falla.
//
//  6. LAS REGLAS NO PUEDEN OCULTAR CAMPOS SUELTOS EN LECTURA. Lo que un rol no
//     debe ver va en OTRO documento, no en otro campo. Por eso los datos
//     personales ampliados del contacto viven en .../conversaciones/{c}/privado.
//
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Ayudantes de identidad
    // -------------------------------------------------------------------------

    // Espacio de nombres corto `nc` dentro de los custom claims. Los custom
    // claims tienen un tope duro de 1000 bytes: las claves cortas son lo que
    // permite que un usuario pertenezca a varios negocios sin reventarlo.
    //
    // Forma: { nc: { p: true, t: { "<tenantId>": "admin" | "oper" | "ingesta" }, v: 3 } }
    //   p → propietario de plataforma (NovuChat)
    //   t → mapa tenantId -> rol
    //   v → versión de claims, para forzar refresco del token desde el cliente
    function autenticado() {
      return request.auth != null && request.auth.uid != null;
    }

    function nc() {
      return request.auth.token.get('nc', {});
    }

    // Propietario de NovuChat. NO implica acceso a conversaciones (ver punto 4).
    // -------------------------------------------------------------------------
    // VÍNCULO ROL ↔ PROVEEDOR DE IDENTIDAD
    //
    // Regla de seguridad, no preferencia:
    //   superadministrador de NovuChat  →  SOLO cuenta de Google
    //   administrador / operador de un comercio  →  SOLO usuario y contraseña
    //   principal de ingesta (n8n)  →  SOLO token personalizado
    //
    // `firebase.sign_in_provider` viaja DENTRO del ID token firmado por Google:
    // dice con qué proveedor se abrió ESTA sesión y el cliente no lo puede
    // alterar. Al meterlo dentro de los predicados base —y no en cada `allow`—
    // el vínculo se vuelve imposible de eludir por olvido: toda regla del
    // archivo pasa por `esPropietario`, `esAdmin`, `esOperador` o `esIngesta`.
    //
    // EFECTO: un claim mal puesto queda INERTE. Si por un error operativo o un
    // fallo en una Function un administrador de comercio recibiera `p: true`,
    // su sesión de contraseña nunca satisface `proveedor() == 'google.com'` y no
    // obtiene nada. El claim solo se activa desde una sesión de Google, que es
    // la que protege el segundo factor de la cuenta de Andres o de Silvana.
    // Ver SEGURIDAD.md, amenaza T-19.
    // -------------------------------------------------------------------------
    function proveedor() {
      return request.auth.token.get('firebase', {}).get('sign_in_provider', '');
    }

    // Correo verificado. Con Google siempre es verdadero; con contraseña es falso
    // hasta que la persona hace clic en el enlace. Exigirlo acá convierte la
    // verificación de correo en un control REAL —el servidor niega los datos—
    // y no en un aviso de la interfaz que se saltea recargando la página.
    function correoVerificado() {
      return request.auth.token.get('email_verified', false) == true;
    }

    function esPropietario() {
      return autenticado()
        && nc().get('p', false) == true
        && proveedor() == 'google.com';
    }

    // Rol del usuario EN ESTE tenant, o cadena vacía. `tenantId` viene siempre
    // del path, nunca de un dato que el cliente pueda elegir.
    //
    // EL DEFECTO QUE SE ARREGLÓ ACÁ. Antes esta función devolvía `null` cuando el
    // usuario no tenía rol en el tenant. Comparar `null == 'admin'` no da falso
    // en el lenguaje de reglas: lanza *Null value error*, que deniega la
    // operación por error de evaluación en vez de por la condición. El efecto
    // real era que el propietario de NovuChat NO podía leer `/auditoria`,
    // `/invitaciones` ni `/accesosSoporte` —todas reglas de la forma
    // `esAdmin(t) || esPropietario()`, donde `esAdmin` se evalúa primero y
    // reventaba antes de llegar a la segunda rama—. Con la cadena vacía como
    // valor por defecto, la comparación es siempre entre cadenas y da falso
    // limpio. Lo destapó la prueba de contactos del propietario.
    function rolEn(tenantId) {
      return nc().get('t', {}).get(tenantId, '');
    }

    // Se compone de los predicados de arriba para HEREDAR el vínculo con el
    // proveedor. Si se definiera otra vez a partir de `rolEn`, sería el agujero
    // por el que se cuela todo: un rol sin proveedor comprobado.
    function esMiembro(tenantId) {
      return esPersonaDelNegocio(tenantId) || esIngesta(tenantId);
    }

    // Las personas del comercio entran SOLO con usuario y contraseña, y solo con
    // el correo ya verificado.
    function esAdmin(tenantId) {
      return autenticado()
        && rolEn(tenantId) == 'admin'
        && proveedor() == 'password'
        && correoVerificado();
    }

    function esOperador(tenantId) {
      return autenticado()
        && rolEn(tenantId) == 'oper'
        && proveedor() == 'password'
        && correoVerificado();
    }

    // Principal de servicio de n8n, acotado a UN tenant. Se obtiene con un token
    // efímero (1 h) que emite la Cloud Function de intercambio; n8n nunca guarda
    // una clave de cuenta de servicio con alcance de proyecto.
    // El principal de servicio llega con un token personalizado emitido por la
    // Cloud Function tras validar la firma HMAC. Atarlo a `custom` impide que
    // una persona —con Google o con contraseña— use un claim de ingesta para
    // escribir en el historial de conversaciones, que es inmutable justamente
    // para que sirva como evidencia.
    function esIngesta(tenantId) {
      return autenticado()
        && rolEn(tenantId) == 'ingesta'
        && proveedor() == 'custom';
    }

    // Persona (admin u operador). Excluye al principal de servicio, que es
    // ciego por diseño: escribe conversaciones y no puede leerlas.
    function esPersonaDelNegocio(tenantId) {
      return esAdmin(tenantId) || esOperador(tenantId);
    }

    // -------------------------------------------------------------------------
    // Ayudantes de estado (cuestan una lectura documental cada uno)
    // -------------------------------------------------------------------------

    // ESTADOS DE UN COMERCIO — la palanca comercial de NovuChat.
    //
    //   'activo'        opera con normalidad.
    //   'suspendido'    palanca por falta de pago. El asistente DEJA de atender
    //                   a los clientes finales y el comercio deja de poder
    //                   editar nada, pero SIGUE VIENDO SUS DATOS. Reversible al
    //                   instante y sin tocar los claims.
    //   'dado_de_baja'  fin de contrato. Ni lectura ni escritura desde el panel.
    //
    // Consultar el estado en cada operación cuesta UNA lectura documental (que
    // además se cachea dentro de la misma petición) y compra algo que no se
    // puede comprar de otro modo: EFECTO INMEDIATO. Un ID token vive hasta una
    // hora; si la suspensión dependiera de los claims, el comercio seguiría
    // operando durante todo ese rato después de que se le cortó el servicio.
    // Para una palanca de cobranza, una hora de retraso la vuelve inútil.
    function estadoTenant(tenantId) {
      return exists(/databases/$(database)/documents/tenants/$(tenantId))
        ? get(/databases/$(database)/documents/tenants/$(tenantId)).data.get('estado', '')
        : '';
    }

    // -------------------------------------------------------------------------
    // VERTICAL DEL COMERCIO — qué capacidades tiene.
    //
    // Lo fija NovuChat al dar de alta o al asignar el número; el comercio no lo
    // escribe. De acá cuelga qué documentos de configuración puede tocar y qué
    // colecciones le corresponden.
    //
    // El objetivo no es cosmético. Un comercio de gastronomía **no puede
    // escribir** configuración de calendario, y uno de belleza **no puede
    // escribir** el recargo de flota — no es que la pantalla se los esconda: las
    // reglas los rechazan. Esconder en la interfaz no protege de nada; lo que
    // protege es que el campo no exista para ese comercio.
    // -------------------------------------------------------------------------
    function verticalTenant(tenantId) {
      return exists(/databases/$(database)/documents/tenants/$(tenantId))
        ? get(/databases/$(database)/documents/tenants/$(tenantId)).data.get('vertical', '')
        : '';
    }

    // Capacidades, expresadas como tabla y no como condiciones sueltas: agregar
    // un vertical es tocar estas dos líneas, no cazar `if` por el archivo.
    function tieneAgenda(tenantId) {
      return verticalTenant(tenantId) in ['agendamiento'];
    }

    function tieneCobro(tenantId) {
      return verticalTenant(tenantId) in ['venta'];
    }

    // Habilita ESCRITURA y la ingesta desde n8n. Solo 'activo'.
    function tenantOperativo(tenantId) {
      return estadoTenant(tenantId) == 'activo';
    }

    // Habilita LECTURA en el panel. Un comercio suspendido sigue viendo lo suyo:
    // son sus datos, y cortarle la vista no ayuda a cobrarle — le quita la
    // manera de verificar lo que se le factura.
    function tenantLegible(tenantId) {
      return estadoTenant(tenantId) in ['activo', 'suspendido'];
    }

    // Acceso de soporte: el propietario de NovuChat solo lee conversaciones si
    // el negocio le concedió una ventana con vencimiento. La concesión la crea
    // una Cloud Function a pedido de un admin del negocio y queda auditada.
    function soporteVigente(tenantId) {
      return esPropietario()
        && exists(/databases/$(database)/documents/tenants/$(tenantId)/accesosSoporte/$(request.auth.uid))
        && get(/databases/$(database)/documents/tenants/$(tenantId)/accesosSoporte/$(request.auth.uid))
             .data.get('expira', request.time) > request.time;
    }

    function puedeLeerConversaciones(tenantId) {
      return (esPersonaDelNegocio(tenantId) && tenantLegible(tenantId))
        || soporteVigente(tenantId);
    }

    // -------------------------------------------------------------------------
    // Ayudantes de validación
    // -------------------------------------------------------------------------

    function soloCampos(permitidos) {
      return resource != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(permitidos);
    }

    // NOTA IMPORTANTE SOBRE EL ESTILO DE ESTAS VALIDACIONES
    // -----------------------------------------------------
    // En el lenguaje de reglas, leer una clave ausente de un mapa (`d.campo`)
    // NO devuelve nulo: lanza un error de evaluación. Un error de evaluación
    // deniega la operación, así que "parece" seguro, pero deniega por el motivo
    // equivocado: la misma expresión puede tumbar una escritura legítima y deja
    // ruido de diagnóstico imposible de leer. Por eso acá TODO acceso a campos
    // usa `d.get(clave, valorPorDefecto)`, que sí devuelve el valor por defecto
    // cuando la clave falta. El valor por defecto se elige de modo que un campo
    // opcional ausente PASE la validación y uno obligatorio ausente la falle.

    function cadena(valor, maxLargo) {
      return valor is string && valor.size() <= maxLargo;
    }

    // Campo obligatorio de texto, no vacío.
    function textoReq(datos, campo, maxLargo) {
      return cadena(datos.get(campo, null), maxLargo)
        && datos.get(campo, '').size() > 0;
    }

    // Campo opcional de texto: ausente equivale a cadena vacía y pasa.
    function textoOpc(datos, campo, maxLargo) {
      return cadena(datos.get(campo, ''), maxLargo);
    }

    // -------------------------------------------------------------------------
    // ID DE CALENDARIO DE GOOGLE — el dato que más caro salió en este proyecto.
    //
    // Un ID pegado a mano con UN carácter de menos hizo que Google devolviera 404
    // al crear la cita, que el agente la confirmara igual, y que la lectura de
    // disponibilidad fallara en silencio: el agente pasó a INVENTAR los horarios
    // y llegó a ofrecer las 15:00 pisando una cita de las 15:30. El síntoma no
    // apuntaba a la causa por ninguna parte.
    //
    // Ahora que va a haber un calendario POR FUNCIONARIO cargado desde el panel,
    // la validación no puede quedar confiada al cuidado de quien lo pega.
    //
    // DOS TRAMPAS, las dos aprendidas escribiendo `scripts/fijar-calendario.sh`:
    //
    //  1. EXACTAMENTE 64 hexadecimales. No «32 o más». La primera versión de
    //     aquel script aceptaba un ID truncado, que es justo el caso que existía
    //     para impedir. Un validador que no rechaza el caso que motivó
    //     escribirlo no valida nada.
    //
    //  2. EL ORDEN IMPORTA. Un ID de calendario TIENE forma de correo. Si se
    //     prueba primero la forma de correo, un ID de grupo malformado cae ahí y
    //     pasa. Acá esa precedencia se expresa con la negación de la segunda
    //     rama: lo que termina en `@group.calendar.google.com` se juzga
    //     ÚNICAMENTE con la regla estricta, sin red de rescate.
    // -------------------------------------------------------------------------
    function calendarioValido(valor) {
      return valor is string
        && (valor.matches('^[0-9a-fA-F]{64}@group[.]calendar[.]google[.]com$')
            || (!valor.matches('^.*@group[.]calendar[.]google[.]com$')
                && valor.matches('^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+[.][A-Za-z]{2,24}$')));
    }

    // Vacío es válido: significa «este funcionario no tiene agenda propia» o
    // «el comercio todavía no cargó la suya». Lo que NO puede pasar es que haya
    // un valor con forma equivocada, porque eso falla en silencio.
    function calendarioValidoOpcional(datos, campo) {
      return !datos.keys().hasAny([campo])
        || datos[campo] == ''
        || calendarioValido(datos[campo]);
    }

    // Sello de auditoría: quien escribe no puede mentir sobre quién es ni sobre
    // cuándo escribió. Sin esto, la pista de auditoría es decorativa.
    function selloValido(datos) {
      return datos.get('actualizadoPor', '') == request.auth.uid
        && datos.get('actualizadoEn', null) == request.time;
    }

    // =========================================================================
    // /tenants/{tenantId} — ficha del negocio
    // =========================================================================
    match /tenants/{tenantId} {

      // `get` puntual: miembros del propio tenant y el propietario de NovuChat.
      allow get: if esMiembro(tenantId) || esPropietario();

      // `list` (consulta sobre la colección): SOLO el propietario. Sin esta
      // separación, cualquier usuario autenticado podría enumerar la cartera
      // completa de clientes de NovuChat, que es información comercial sensible
      // aunque no incluya conversaciones.
      allow list: if esPropietario();

      // Alta, baja y cambio de plan pasan SIEMPRE por Cloud Functions con el SDK
      // Admin, que además emiten los custom claims, escriben la auditoría e
      // impiden reutilizar un tenantId dado de baja. Ningún navegador escribe acá.
      allow create, update, delete: if false;

      // -----------------------------------------------------------------------
      // /config/{documento} — la configuración que hoy vive en el nodo
      // `Config del negocio` de los flujos de n8n.
      // -----------------------------------------------------------------------
      match /config/{documento} {

        allow get, list: if esMiembro(tenantId);

        // Solo el admin del negocio edita la configuración, y solo el documento
        // `negocio`. La creación y el borrado los hace la Function de alta/baja:
        // así el documento nunca queda a medio formar ni desaparece por error.
        // TRES DOCUMENTOS, NO UNO CON LA UNIÓN DE TODOS LOS CAMPOS.
        //
        //   `negocio`       lo COMÚN a cualquier comercio: identidad, horarios,
        //                   voz del asistente, mensajes fijos.
        //   `agendamiento`  solo para el vertical de citas: duración por
        //                   defecto, anticipación mínima, recordatorios.
        //   `venta`         solo para venta y cobro: delivery, tiempos de
        //                   cocina y despacho, y el QR del cobro SIMULADO.
        //
        // POR QUÉ PARTIDO Y NO UN SOLO DOCUMENTO GRANDE. Tres razones, en orden
        // de importancia:
        //
        //  1. La validación queda POR DOCUMENTO, con su propia lista blanca. Un
        //     único esquema obligaría a escribir «si el vertical es X entonces
        //     el campo Y es válido» dentro de las reglas, que es exactamente el
        //     tipo de condición que se rompe al agregar el tercer vertical.
        //  2. **El comercio no puede escribir el documento del vertical que no
        //     le toca.** Un salón de belleza no puede fijar el recargo de flota
        //     ni por accidente ni a propósito. Eso no se logra escondiendo el
        //     campo en la pantalla.
        //  3. La pantalla muestra lo que corresponde sin ninguna lógica de
        //     ramas: lee el documento común y el de su vertical, y ya.
        allow update: if esAdmin(tenantId)
                      && tenantOperativo(tenantId)
                      && (
                        (documento == 'negocio' && configNegocioValida())
                        || (documento == 'agendamiento' && tieneAgenda(tenantId)
                            && configAgendamientoValida())
                        || (documento == 'venta' && tieneCobro(tenantId)
                            && configVentaValida())
                      );
        // Los crea `altaTenant` según el vertical, para que ningún documento
        // quede a medio formar ni exista uno que no corresponde.
        allow create, delete: if false;

        // =====================================================================
        // ESQUEMA DE LA CONFIGURACIÓN DEL NEGOCIO
        //
        // El panel es la FUENTE DE VERDAD: n8n ya no tiene estos valores escritos
        // a mano en el nodo `Config del negocio`, los consulta. Eso invierte la
        // responsabilidad y convierte a esta pantalla en **la superficie por
        // donde entra lo que el asistente va a afirmar como verdad ante un
        // cliente final**. La validación de acá no es higiene: es el único punto
        // donde se puede frenar un dato que después sale por WhatsApp.
        //
        // TRES CLASES DE CAMPO, Y LA DIFERENCIA IMPORTA:
        //
        //  1. ENUMERADOS (`tratamiento`, `estiloEmojis`, `zonaHoraria`,
        //     `moneda`). Lista cerrada. El código los traduce a una frase fija
        //     antes de armar el prompt: el texto del cliente NUNCA se interpola.
        //     Convertir un campo libre en un enumerado es la defensa más fuerte
        //     que existe contra la inyección de prompt, porque elimina el texto
        //     libre en vez de intentar limpiarlo.
        //
        //  2. TEXTO LIBRE que viaja al prompt (`direccion`, `politicaCancelacion`,
        //     `datosQueNoTenemos`, `instruccionesExtra`, los `mensaje*`). Van
        //     TOPEADOS y el flujo los inserta en una sección delimitada y
        //     rotulada como DATO DEL NEGOCIO, nunca por delante de las reglas de
        //     comportamiento del agente. La lista completa está en DISENO.md
        //     §4quater.2.
        //
        //  3. DERIVADOS, QUE NO SE GUARDAN ACÁ. `estadoComercio`,
        //     `phoneNumberId` y `horarioAtencion` los calcula
        //     `configuracionFlujo` leyendo la ficha del tenant. Que NO estén en
        //     la lista blanca es una defensa, no un olvido: ver más abajo.
        // =====================================================================
        function configNegocioValida() {
          let d = request.resource.data;
          let clavesPermitidas = [
            // Identidad y contacto
            'nombreNegocio', 'descripcion', 'direccion', 'numeroRecepcion',
            'zonaHoraria', 'moneda', 'calendarioId',
            // Operación
            'horarios', 'politicaCancelacion', 'prefijosPermitidos',
            'datosQueNoTenemos',
            // Voz del asistente (enumerados)
            'tratamiento', 'estiloEmojis',
            // Mensajes fijos
            'mensajes', 'mensajeCierre', 'mensajeErrorTemporal',
            'mensajeReservaNoConfirmada', 'mensajeComercioSuspendido',
            'instruccionesExtra',
            // Sello
            'actualizadoPor', 'actualizadoEn'
          ];
          return d.keys().hasOnly(clavesPermitidas)
            && d.keys().hasAll(['nombreNegocio', 'actualizadoPor', 'actualizadoEn'])
            && textoReq(d, 'nombreNegocio', 80)
            && textoOpc(d, 'descripcion', 400)

            // DIRECCIÓN — el campo del incidente del 28/08.
            // Ante «donde queda su clinica?» el agente INVENTO una direccion:
            // zona y avenida que no figuraban en ninguna parte. Para una demo
            // comercial es el peor defecto posible, porque un cliente puede
            // presentarse en un lugar que no existe.
            //
            // Es OPCIONAL a propósito. Obligarla tentaría a rellenarla con
            // cualquier cosa para poder guardar, y un dato inventado por el
            // comercio es igual de dañino que uno inventado por el modelo. Vacía
            // significa «no la tenemos», y `configuracionFlujo` la agrega
            // automáticamente a `datosQueNoTenemos` para que el agente responda
            // que la va a consultar. Ver DISENO.md §4quater.3.
            && textoOpc(d, 'direccion', 200)

            && d.get('zonaHoraria', 'America/La_Paz') in ['America/La_Paz']
            && d.get('moneda', 'BOB') in ['BOB', 'USD']
            // Teléfono en formato E.164 sin '+', igual que lo espera la Cloud API.
            && d.get('numeroRecepcion', '59100000000') is string
            && d.get('numeroRecepcion', '59100000000').matches('^[0-9]{8,15}$')
            // Misma validación estricta que para los funcionarios: un ID mal
            // pegado acá tiene exactamente las mismas consecuencias.
            && calendarioValidoOpcional(d, 'calendarioId')
            && d.get('horarios', {}) is map

            && textoOpc(d, 'politicaCancelacion', 600)

            // Listas. Las reglas NO saben recorrer los elementos de una lista, así
            // que acá solo se comprueba el tipo y el tamaño; el contenido lo
            // valida y recorta la Cloud Function antes de que llegue al prompt.
            // Está dicho en SEGURIDAD.md, T-27, para que nadie suponga más de lo
            // que esta línea garantiza.
            && d.get('prefijosPermitidos', []) is list
            && d.get('prefijosPermitidos', []).size() <= 10
            && d.get('datosQueNoTenemos', []) is list
            && d.get('datosQueNoTenemos', []).size() <= 20

            // VOZ DEL ASISTENTE — enumerados, no texto libre.
            // `tratamiento` cierra además el defecto de estilo de ESTADO.md: el
            // agente alternaba «usted» y «tú» con el mismo cliente.
            && d.get('tratamiento', 'usted') in ['usted', 'tu', 'neutro']
            && d.get('estiloEmojis', 'pocos') in ['ninguno', 'pocos', 'muchos']

            && d.get('mensajes', {}) is map
            && textoOpc(d, 'mensajeCierre', 300)
            && textoOpc(d, 'mensajeErrorTemporal', 300)
            && textoOpc(d, 'mensajeReservaNoConfirmada', 300)
            // Se puede escribir MIENTRAS EL COMERCIO ESTÁ ACTIVO, porque toda
            // escritura de configuración exige `tenantOperativo`. Consecuencia
            // buscada: nadie redacta el mensaje de suspensión DESPUÉS de que lo
            // suspendieron. Ver SEGURIDAD.md, T-26.
            && textoOpc(d, 'mensajeComercioSuspendido', 300)

            && textoOpc(d, 'instruccionesExtra', 1500)
            && selloValido(d);
        }

        // =====================================================================
        // VERTICAL DE AGENDAMIENTO — lo que el Demo B no necesita.
        // El calendario del comercio y los funcionarios ya viven en otro lado;
        // acá van los parámetros de cómo se agenda.
        // =====================================================================
        function configAgendamientoValida() {
          let d = request.resource.data;
          return d.keys().hasOnly([
                   'duracionPorDefectoMin', 'anticipacionMinimaMin',
                   'anticipacionMaximaDias', 'permitirCancelacion',
                   'horasRecordatorio', 'mensajeRecordatorio',
                   'actualizadoPor', 'actualizadoEn'
                 ])
            && d.get('duracionPorDefectoMin', 30) is int
            && d.get('duracionPorDefectoMin', 30) > 0
            && d.get('duracionPorDefectoMin', 30) <= 480
            // Anticipación mínima: evita que alguien reserve para dentro de dos
            // minutos y el negocio se entere cuando el cliente ya está en la puerta.
            && d.get('anticipacionMinimaMin', 60) is int
            && d.get('anticipacionMinimaMin', 60) >= 0
            && d.get('anticipacionMinimaMin', 60) <= 10080
            && d.get('anticipacionMaximaDias', 60) is int
            && d.get('anticipacionMaximaDias', 60) > 0
            && d.get('anticipacionMaximaDias', 60) <= 365
            && d.get('permitirCancelacion', true) is bool
            && d.get('horasRecordatorio', 24) is int
            && d.get('horasRecordatorio', 24) >= 0
            && d.get('horasRecordatorio', 24) <= 168
            && textoOpc(d, 'mensajeRecordatorio', 400)
            && selloValido(d);
        }

        // =====================================================================
        // VERTICAL DE VENTA Y COBRO — lo que el Demo A no necesita.
        //
        // ⚠️ ACÁ ESTÁ EL CAMPO MÁS DELICADO DEL PROYECTO. La prohibición 3 de
        // CLAUDE.md dice que un cobro simulado NUNCA se presenta como real. Los
        // rótulos que lo sostienen —el texto impreso en el QR, el epígrafe y la
        // confirmación— **NO son configurables por el comercio**: viven en
        // `/plataforma/cobroSimulado`, son de NovuChat y son iguales para todos.
        //
        // Y `mediaIdQr` TAMPOCO lo escribe el comercio, aunque parezca un dato
        // técnico inocente. Es el identificador de la IMAGEN, y la imagen lleva
        // el rótulo impreso: quien pueda cambiarlo puede subir un QR sin rótulo
        // y saltear la prohibición por la puerta de atrás, sin tocar un solo
        // texto. Lo carga NovuChat con `registrarQr`, que además es coherente
        // con el hallazgo 19 de ESTADO.md — un media ID queda ligado al número
        // que lo sube, y el número también lo asigna NovuChat.
        //
        // Lo que el comercio SÍ decide es lo comercial: cuánto cobra de envío,
        // cuánto recarga por flota y cuánto tarda.
        // =====================================================================
        function configVentaValida() {
          let d = request.resource.data;
          return
            // Lista blanca de lo que el comercio puede TOCAR. `mediaIdQr` y los
            // rótulos no están, así que un intento de cambiarlos no coincide.
            soloCampos([
              'costoDelivery', 'recargoFlota', 'radioEntregaKm',
              'tiempoCocinaMin', 'tiempoDespachoMin', 'pedidoMinimo',
              'aceptaDelivery', 'aceptaRetiroEnLocal',
              'actualizadoPor', 'actualizadoEn'
            ])
            && d.get('costoDelivery', 0) is number
            && d.get('costoDelivery', 0) >= 0 && d.get('costoDelivery', 0) <= 1000
            && d.get('recargoFlota', 0) is number
            && d.get('recargoFlota', 0) >= 0 && d.get('recargoFlota', 0) <= 1000
            && d.get('pedidoMinimo', 0) is number
            && d.get('pedidoMinimo', 0) >= 0 && d.get('pedidoMinimo', 0) <= 100000
            && d.get('radioEntregaKm', 5) is number
            && d.get('radioEntregaKm', 5) > 0 && d.get('radioEntregaKm', 5) <= 100
            && d.get('tiempoCocinaMin', 20) is int
            && d.get('tiempoCocinaMin', 20) >= 0 && d.get('tiempoCocinaMin', 20) <= 480
            && d.get('tiempoDespachoMin', 30) is int
            && d.get('tiempoDespachoMin', 30) >= 0 && d.get('tiempoDespachoMin', 30) <= 480
            && d.get('aceptaDelivery', true) is bool
            && d.get('aceptaRetiroEnLocal', true) is bool
            && selloValido(d);
        }
      }

      // -----------------------------------------------------------------------
      // /catalogo/{itemId} — productos o servicios con precio.
      // Va en subcolección, no como lista dentro de config, para que cada ítem
      // se pueda validar de verdad: las reglas no saben recorrer listas de mapas.
      // -----------------------------------------------------------------------
      match /catalogo/{itemId} {

        allow get, list: if esMiembro(tenantId);

        allow create, update: if esAdmin(tenantId)
                              && tenantOperativo(tenantId)
                              && itemValido();
        allow delete: if esAdmin(tenantId) && tenantOperativo(tenantId);

        function itemValido() {
          let d = request.resource.data;
          return d.keys().hasOnly([
                   'nombre', 'descripcion', 'precio', 'moneda', 'duracionMin',
                   'activo', 'actualizadoPor', 'actualizadoEn'
                 ])
            && textoReq(d, 'nombre', 80)
            && textoOpc(d, 'descripcion', 300)
            // Número y no negativo: un precio negativo llega al agente y al
            // cliente final como una promesa que el negocio no quiso hacer.
            && d.get('precio', null) is number
            && d.get('precio', -1) >= 0 && d.get('precio', -1) <= 1000000
            && d.get('moneda', '') in ['BOB', 'USD']
            && d.get('duracionMin', 30) is int
            && d.get('duracionMin', 30) > 0 && d.get('duracionMin', 30) <= 1440
            && d.get('activo', null) is bool
            && selloValido(d);
        }
      }

      // -----------------------------------------------------------------------
      // /funcionarios/{funcionarioId} — QUIÉN ATIENDE.
      //
      // EL PROBLEMA QUE RESUELVE. El modelo asumía un calendario por comercio, y
      // eso produce un error visible: una cita de manicure a las 11:30 bloquea
      // una de ortodoncia a las 11:30, cuando las atienden personas distintas.
      // Lo que hay que impedir es que UN MISMO FUNCIONARIO tenga dos citas
      // simultáneas, no que el comercio tenga dos.
      //
      // EL CASO DE UNA SOLA PERSONA SIGUE SIENDO TRIVIAL. Muchas PyMEs bolivianas
      // son una persona sola. Esta colección puede estar VACÍA: si no hay ningún
      // funcionario activo, `configuracionFlujo` fabrica uno por defecto con el
      // calendario y los horarios del comercio, y el flujo ve siempre al menos
      // uno. **La complejidad la paga quien la necesita.**
      //
      // HORARIO PROPIO. `horarioTrabajo` puede diferir del horario del comercio,
      // y ahí está la mitad de la gracia: el salón abre de 9 a 19 pero el
      // odontólogo va martes y jueves de 14 a 18.
      //
      // DATOS PERSONALES. El teléfono y el correo del funcionario son datos de
      // un tercero que NO es el cliente final. Como las reglas no pueden ocultar
      // campos sueltos en una lectura, van en `/privado/datos`, igual que con los
      // contactos y con los datos ampliados de las conversaciones. El operador ve
      // quién atiende qué —lo necesita para responder— pero no el teléfono
      // personal de la manicurista, que no necesita para nada.
      // -----------------------------------------------------------------------
      match /funcionarios/{funcionarioId} {

        // Lo operativo lo ve toda persona del negocio: es lo que hace falta para
        // contestar «¿quién atiende ortodoncia?».
        allow get, list: if (esPersonaDelNegocio(tenantId) && tenantLegible(tenantId))
                         || esIngesta(tenantId)
                         || soporteVigente(tenantId);

        // Solo el vertical de agendamiento. Una parrilla no tiene profesionales
        // con calendario propio, y ofrecerle la pantalla sería ruido. Si algún
        // día un vertical nuevo los necesita, se agrega a `tieneAgenda`: una
        // línea, y por eso las capacidades están en una tabla y no dispersas.
        allow create, update: if esAdmin(tenantId)
                              && tenantOperativo(tenantId)
                              && tieneAgenda(tenantId)
                              && funcionarioValido();
        // Baja LÓGICA con `activo: false`, no borrado: un funcionario borrado
        // dejaría citas pasadas apuntando a un identificador que ya no existe.
        allow delete: if false;

        function funcionarioValido() {
          let d = request.resource.data;
          return d.keys().hasOnly([
                   'nombre', 'especialidad', 'calendarioId', 'horarioTrabajo',
                   'servicios', 'activo', 'actualizadoPor', 'actualizadoEn'
                 ])
            && textoReq(d, 'nombre', 120)
            && textoOpc(d, 'especialidad', 80)
            // EL CAMPO CARO. Ver `calendarioValido` arriba: 64 hexadecimales
            // exactos, y el sufijo decide antes que la forma de correo.
            && calendarioValidoOpcional(d, 'calendarioId')
            && d.get('horarioTrabajo', {}) is map
            // Relación servicio -> funcionario, denormalizada de este lado.
            // Las reglas no saben recorrer una lista: acá solo el tipo y el
            // tamaño. Que los identificadores existan lo resuelve la Function,
            // que descarta las referencias colgadas (ver DISENO.md §4quinquies.2).
            && d.get('servicios', []) is list
            && d.get('servicios', []).size() <= 50
            && d.get('activo', null) is bool
            && selloValido(d);
        }

        // Teléfono y correo del funcionario. Solo el administrador del negocio.
        match /privado/{documento} {
          allow get, list: if esAdmin(tenantId) && tenantLegible(tenantId);
          allow create, update: if esAdmin(tenantId) && tenantOperativo(tenantId)
                                && datosPersonalesValidos();
          allow delete: if false;

          function datosPersonalesValidos() {
            let d = request.resource.data;
            return d.keys().hasOnly(['telefono', 'correo', 'notas',
                                     'actualizadoPor', 'actualizadoEn'])
              && (!d.keys().hasAny(['telefono'])
                  || d.telefono.matches('^[0-9]{8,15}$'))
              && textoOpc(d, 'correo', 254)
              && textoOpc(d, 'notas', 300)
              && selloValido(d);
          }
        }
      }

      // -----------------------------------------------------------------------
      // /agenda/{ranuraId} — EL CANDADO CONTRA LA DOBLE RESERVA.
      //
      // POR QUÉ EXISTE. Google Calendar **no impide eventos superpuestos**: si
      // dos clientes reservan a la vez, crea las dos citas sin chistar. Y entre
      // «consultar disponibilidad» y «crear la cita» pasan segundos, que es
      // tiempo de sobra para que otro cliente tome el mismo horario. La garantía
      // no puede vivir en Calendar.
      //
      // CÓMO FUNCIONA. El día se parte en RANURAS fijas de 15 minutos. Una cita
      // de 60 minutos ocupa cuatro. El identificador del documento es
      // determinista —`{funcionarioId}_{aaaammdd}_{ranura}`— y la reserva se hace
      // con `create` DENTRO DE UNA TRANSACCIÓN: `create` falla si el documento ya
      // existe, y la transacción hace que las cuatro ranuras se tomen todas o
      // ninguna. Eso es exclusión mutua de verdad, no una comprobación previa.
      //
      // La superposición parcial queda cubierta porque el choque no se busca por
      // hora de inicio sino por ranura: 11:00–12:00 y 11:30–12:30 comparten dos.
      //
      // LO QUE ESTE CANDADO **NO** GARANTIZA, dicho sin adornos: solo conoce las
      // citas que pasaron por el asistente. Si alguien del comercio carga una
      // cita A MANO en Google Calendar, esta colección no se entera y el choque
      // vuelve a ser posible. Por eso el flujo sigue consultando Calendar antes
      // de ofrecer horarios: Calendar cubre lo manual, el candado cubre la
      // concurrencia. Ninguno de los dos alcanza solo. Ver SEGURIDAD.md, T-30.
      //
      // NO LLEVA DATOS PERSONALES: ni teléfono ni nombre del cliente. Es un
      // candado, no un registro.
      // -----------------------------------------------------------------------
      match /agenda/{ranuraId} {

        allow get, list: if (esPersonaDelNegocio(tenantId) && tenantLegible(tenantId))
                         || esIngesta(tenantId);

        allow create: if esIngesta(tenantId)
                      && tenantOperativo(tenantId)
                      && ranuraValida();

        // NO se actualiza: mover una cita es liberar y volver a tomar, para que
        // la operación siga siendo atómica.
        allow update: if false;
        // SÍ se borra: una cita cancelada tiene que liberar sus ranuras o el
        // horario queda bloqueado para siempre. La cancelación queda en la
        // bitácora, que es donde vive la evidencia.
        allow delete: if esIngesta(tenantId);

        function ranuraValida() {
          let d = request.resource.data;
          return d.keys().hasOnly([
                   'funcionarioId', 'inicio', 'fin', 'servicioId',
                   'conversacionId', 'creadoEn'
                 ])
            && textoReq(d, 'funcionarioId', 80)
            && d.get('inicio', null) is timestamp
            && d.get('fin', null) is timestamp
            && d.get('fin', null) > d.get('inicio', null)
            && textoOpc(d, 'servicioId', 80)
            && textoOpc(d, 'conversacionId', 80)
            && d.get('creadoEn', null) == request.time;
        }
      }

      // -----------------------------------------------------------------------
      // /contactos/{contactoId} — PERSONAS DE REFERENCIA DEL COMERCIO.
      //
      // No confundir con /miembros: aquéllos son usuarios DEL PANEL. Éstos son
      // las personas de contacto del negocio —el dueño, quien atiende recepción,
      // quien factura— que en general NO tienen acceso al panel y que muchas
      // veces ni saben que están anotadas acá.
      //
      // Son DATOS PERSONALES DE TERCEROS y se les aplica el mismo criterio que a
      // /conversaciones/{c}/privado: como las reglas de Firestore no pueden
      // ocultar campos sueltos en una lectura, lo que un rol no debe ver va en
      // OTRA colección. Por eso viven acá y no como campos de la ficha del
      // tenant, que la leen todos los miembros.
      //
      // QUIÉN ENTRA:
      //   admin del negocio  → todo. Es su agenda.
      //   operador           → NADA. Atender conversaciones no requiere el
      //                        teléfono del contador del negocio. Mínimo
      //                        privilegio, sin excepción cómoda.
      //   NovuChat           → SOLO los marcados `esContactoComercial`. Es a
      //                        quién llamar por la factura, y nada más. Para el
      //                        resto necesita acceso de soporte vigente, igual
      //                        que para las conversaciones.
      //
      // ⚠️ SOBRE `list` Y EL FILTRO: en Firestore las reglas NO filtran
      // resultados. Para que el propietario pueda listar, su consulta tiene que
      // traer `where('esContactoComercial','==',true)`; si no lo trae, la
      // consulta falla ENTERA. Eso es correcto y deliberado: el modo de fallar
      // es negar, nunca devolver de más. El `get` puntual de un contacto
      // comercial sí funciona sin ninguna condición extra.
      // -----------------------------------------------------------------------
      match /contactos/{contactoId} {

        allow get, list: if (esAdmin(tenantId) && tenantLegible(tenantId))
                         || soporteVigente(tenantId)
                         || (esPropietario()
                             && resource.data.get('esContactoComercial', false) == true);

        allow create, update: if esAdmin(tenantId)
                              && tenantOperativo(tenantId)
                              && contactoValido();
        allow delete: if esAdmin(tenantId) && tenantOperativo(tenantId);

        function contactoValido() {
          let d = request.resource.data;
          return d.keys().hasOnly([
                   'nombre', 'rolNegocio', 'telefono', 'correo', 'notas',
                   'esContactoComercial', 'actualizadoPor', 'actualizadoEn'
                 ])
            && textoReq(d, 'nombre', 120)
            // Lista cerrada de roles: evita que este campo se convierta en un
            // texto libre más donde acabe cayendo información que nadie previó.
            && d.get('rolNegocio', '') in ['dueno', 'recepcion', 'facturacion',
                                           'tecnico', 'otro']
            && d.get('telefono', '') is string
            && d.get('telefono', '').matches('^[0-9]{8,15}$')
            && textoOpc(d, 'correo', 254)
            // Tope corto en las notas: este campo NO es una ficha clínica ni un
            // historial. Cuanto menos dato personal de terceros se acumule, menor
            // es el daño de cualquier fuga.
            && textoOpc(d, 'notas', 500)
            && d.get('esContactoComercial', false) is bool
            && selloValido(d);
        }
      }

      // -----------------------------------------------------------------------
      // /cuenta/estado — ESTADO DE CUENTA, VISIBLE PARA EL COMERCIO.
      //
      // Plan, situación de pago y próximo vencimiento. El comercio necesita
      // poder responder solo la pregunta "¿estoy al día?" sin llamar a nadie.
      //
      // ES DE SOLO LECTURA PARA ÉL. Cambiarlo es de NovuChat, por Cloud
      // Function, y queda auditado. Si el comercio pudiera escribirlo, se
      // pondría `al_dia` y el estado de cuenta dejaría de significar nada.
      //
      // SE LEE CON `tenantLegible`, NO CON `tenantOperativo`: es JUSTAMENTE
      // cuando el comercio está suspendido cuando más necesita ver esta
      // pantalla. Un corte de servicio sin explicación visible es una llamada
      // de reclamo garantizada.
      //
      // DOS PÚBLICOS DISTINTOS, NO CONFUNDIRLOS:
      //   `motivoVisible`     → lo lee el COMERCIO. Explica su situación. Es su
      //                         relación comercial y tiene derecho a conocerla.
      //   `motivoSuspension`  → campo de la ficha del tenant, INTERNO, para la
      //                         auditoría de NovuChat.
      // Y ninguno de los dos llega jamás al CLIENTE FINAL de WhatsApp, que
      // recibe un mensaje de cortesía neutro (ver DISENO.md §4bis.3 y T-18).
      //
      // El operador queda afuera: la situación financiera del negocio no es
      // asunto de quien atiende el chat.
      // -----------------------------------------------------------------------
      match /cuenta/{documento} {
        allow get, list: if (esAdmin(tenantId) && tenantLegible(tenantId))
                         || esPropietario();
        allow create, update, delete: if false;
      }

      // -----------------------------------------------------------------------
      // /reclamos/{reclamoId} — RECLAMOS DEL COMERCIO HACIA NOVUCHAT.
      //
      // Se guardan en Firestore ANTES de enviarse por correo. Si el proveedor de
      // correo falla, el reclamo no se pierde: queda acá y se ve en el panel de
      // NovuChat igual. El correo es una notificación, no el registro.
      //
      // INMUTABLES para el cliente. El comercio crea y lee; no edita ni borra.
      // Un reclamo que se puede editar después de enviado no sirve para dirimir
      // nada, y uno que se puede borrar tampoco.
      //
      // El campo `texto` es ENTRADA NO CONFIABLE aunque lo escriba un usuario
      // autenticado: se muestra en el panel y viaja en un correo. Ver T-20.
      // -----------------------------------------------------------------------
      match /reclamos/{reclamoId} {

        allow get, list: if (esPersonaDelNegocio(tenantId) && tenantLegible(tenantId))
                         || esPropietario();

        // Un comercio suspendido SÍ puede reclamar. Sería absurdo cortarle el
        // canal de reclamo justo cuando tiene el motivo más probable para usarlo.
        allow create: if esPersonaDelNegocio(tenantId)
                      && tenantLegible(tenantId)
                      && reclamoValido();

        // Ni el comercio ni NovuChat lo tocan desde el navegador. El cambio de
        // estado (nuevo → en_curso → resuelto) lo hace una Cloud Function, que
        // además audita quién lo movió.
        allow update, delete: if false;

        function reclamoValido() {
          let d = request.resource.data;
          return d.keys().hasOnly([
                   'asunto', 'texto', 'categoria', 'estado',
                   'creadoPor', 'creadoEn', 'correoNotificado'
                 ])
            && textoReq(d, 'asunto', 120)
            && textoReq(d, 'texto', 4000)
            && d.get('categoria', '') in ['facturacion', 'falla', 'configuracion',
                                          'sugerencia', 'otro']
            // El estado nace SIEMPRE en 'nuevo'. Que el cliente pudiera crearlo
            // como 'resuelto' vaciaría de sentido la bandeja de NovuChat.
            && d.get('estado', '') == 'nuevo'
            // Sello: quien reclama no puede reclamar en nombre de otro ni
            // antedatar el reclamo.
            && d.get('creadoPor', '') == request.auth.uid
            && d.get('creadoEn', null) == request.time
            // La marca de correo enviado la pone la Function, nunca el cliente.
            && !d.keys().hasAny(['correoNotificado']);
        }
      }

      // -----------------------------------------------------------------------
      // /miembros/{uid} — espejo de los custom claims, para la interfaz.
      // NO otorga permisos. Es de solo lectura para TODOS los clientes: si fuera
      // escribible, la interfaz mostraría un rol falso y, peor, el patrón
      // invitaría a que alguien lo usara como fuente de autorización.
      // -----------------------------------------------------------------------
      match /miembros/{uid} {
        allow get, list: if esMiembro(tenantId) || esPropietario();
        allow create, update, delete: if false;
      }

      // -----------------------------------------------------------------------
      // /invitaciones/{invitacionId} — alta de usuarios del negocio.
      // El token de invitación NO se guarda en claro: se guarda su hash. Quien
      // lea esta colección no puede aceptar invitaciones ajenas.
      // -----------------------------------------------------------------------
      match /invitaciones/{invitacionId} {
        allow get, list: if esAdmin(tenantId) || esPropietario();
        allow create, update, delete: if false;
      }

      // -----------------------------------------------------------------------
      // /conversaciones/{conversacionId} — visor de conversaciones.
      // Es el dato más sensible del sistema: mensajes de clientes finales.
      // -----------------------------------------------------------------------
      match /conversaciones/{conversacionId} {

        allow get, list: if puedeLeerConversaciones(tenantId);

        // Alta y actualización del hilo: solo el principal de servicio de n8n,
        // acotado a ESTE tenant por su claim. Un token de ingesta del tenant A
        // no satisface `esIngesta(B)`.
        //
        // `tenantOperativo` acá tiene un efecto que conviene entender: cuando se
        // suspende un comercio por falta de pago, la ingesta se cierra y NovuChat
        // deja de acumular datos personales de clientes finales de un comercio
        // que ya no presta el servicio. No es solo una palanca de cobranza: es
        // minimización de datos.
        allow create: if esIngesta(tenantId)
                      && tenantOperativo(tenantId)
                      && conversacionValida();
        allow delete: if false;

        // Dos ramas de actualización disjuntas:
        //  a) n8n actualiza el resumen del hilo;
        //  b) una persona del negocio marca gestión interna, y SOLO puede tocar
        //     los tres campos de gestión. Sin `hasOnly`, un operador podría
        //     reescribir `ultimoMensaje` o `telefono` y falsear el historial.
        allow update: if (esIngesta(tenantId) && tenantOperativo(tenantId)
                          && conversacionValida())
                      || (esPersonaDelNegocio(tenantId)
                          && tenantOperativo(tenantId)
                          && soloCampos(['etiquetas', 'atendidaPor', 'notaInterna'])
                          && textoOpc(request.resource.data, 'notaInterna', 1000));

        function conversacionValida() {
          let d = request.resource.data;
          return d.keys().hasOnly([
                   'telefono', 'nombreContacto', 'ultimoMensaje', 'ultimoEn',
                   'canal', 'mensajesTotal', 'etiquetas', 'atendidaPor',
                   'notaInterna',
                   // Marca del último período en que esta persona ya fue contada
                   // como "atendida" (formato 'aaaa-mm'). La escribe SOLO la
                   // ingesta; no está en la lista de campos de gestión, así que
                   // ninguna persona del negocio puede tocarla para inflar la
                   // métrica que se le factura.
                   'periodoContado',
                   // Las otras dos marcas de conteo, con la misma protección y
                   // por el mismo motivo: son la deduplicación de `atenciones` e
                   // `interacciones`, que se facturan. `respuestasDelPeriodo`
                   // cuenta las respuestas salientes del mes y
                   // `periodoInteraccion` recuerda el período en que esta
                   // conversación ya sumó su interacción, para que la tercera
                   // respuesta no vuelva a sumarla.
                   'respuestasDelPeriodo', 'periodoInteraccion'
                 // `atencionDesde` es el ancla de la ventana de 24 horas: marca
                 // CUANDO EMPEZO la atencion vigente, no el ultimo mensaje. Todo
                 // lo que cae dentro de esa ventana es la misma atencion; lo que
                 // llega despues abre otra.
                 , 'atencionDesde'])
            && d.get('telefono', '') is string
            && d.get('telefono', '').matches('^[0-9]{8,15}$')
            && textoOpc(d, 'nombreContacto', 120)
            // El resumen se recorta en origen: un mensaje entrante de 4 KB no
            // debe poder inflar cada documento del listado.
            && textoOpc(d, 'ultimoMensaje', 300)
            // Entero y no negativo. La ingesta lo CALCULA dentro de la
            // transacción en vez de incrementarlo, así que acá tiene que llegar
            // un número común y corriente: cualquier otra cosa es un defecto.
            && d.get('respuestasDelPeriodo', 0) is int
            && d.get('respuestasDelPeriodo', 0) >= 0
            && d.get('canal', '') in ['whatsapp'];
        }

        // ---------------------------------------------------------------------
        // /mensajes/{mensajeId} — el registro conversacional.
        // INMUTABLE: se crea y no se modifica ni se borra. Un historial que se
        // puede editar no sirve como evidencia ante un reclamo del cliente.
        // ---------------------------------------------------------------------
        match /mensajes/{mensajeId} {
          allow get, list: if puedeLeerConversaciones(tenantId);
          allow create: if esIngesta(tenantId)
                        && tenantOperativo(tenantId)
                        && mensajeValido();
          allow update, delete: if false;

          function mensajeValido() {
            let d = request.resource.data;
            return d.keys().hasOnly(['direccion', 'tipo', 'texto', 'ts', 'idMeta'])
              && d.get('direccion', '') in ['entrante', 'saliente']
              && d.get('tipo', '') in ['text', 'interactive', 'image', 'audio',
                                       'document', 'order', 'location', 'otro']
              // Tope de tamaño del texto. El contenido es DATO NO CONFIABLE:
              // lo escribe un cliente final de WhatsApp. Se guarda tal cual y se
              // escapa al renderizar (ver admin/SEGURIDAD.md, §Regla de Dos).
              && cadena(d.get('texto', null), 4096)
              && d.get('ts', null) is timestamp
              && textoOpc(d, 'idMeta', 120);
          }
        }

        // ---------------------------------------------------------------------
        // /privado/{documento} — datos personales ampliados del contacto.
        // Vive aparte porque las reglas NO pueden ocultar campos sueltos en una
        // lectura: si el dato estuviera en el documento de la conversación,
        // cualquiera que pueda leerla lo vería. Solo el admin del negocio entra.
        // ---------------------------------------------------------------------
        match /privado/{documento} {
          allow get, list: if esAdmin(tenantId) && tenantLegible(tenantId);
          allow create, update: if esIngesta(tenantId) && tenantOperativo(tenantId);
          allow delete: if false;
        }
      }

      // -----------------------------------------------------------------------
      // /metricas/{periodo} — contadores agregados (uno por mes: '2026-09').
      // Los agrega la ruta de ingesta con incrementos atómicos. El panel LEE
      // agregados en vez de contar conversaciones en el cliente: así el visor de
      // métricas no necesita permiso de lectura sobre los mensajes.
      // -----------------------------------------------------------------------
      match /metricas/{periodo} {
        allow get, list: if esMiembro(tenantId) || esPropietario();
        allow create, update: if esIngesta(tenantId)
                              && tenantOperativo(tenantId)
                              && metricaValida();
        allow delete: if false;

        // Lista blanca también acá: si el principal de ingesta quedara
        // comprometido, no debe poder sembrar campos arbitrarios en la colección
        // que sostiene la facturación.
        function metricaValida() {
          return request.resource.data.keys().hasOnly([
            'mensajes', 'entrantes', 'salientes',
            'personasAtendidas',   // conteo de ÚNICOS, no un incremento por mensaje
            'citasAgendadas', 'conversaciones',
            // LAS TRES CIFRAS DE LA OFERTA COMERCIAL. Definiciones exactas en
            // /cierres, más abajo. Están acá porque son el agregado por período
            // que se muestra y se factura; el detalle auditable vive en la
            // colección, no en este contador.
            'cierres', 'atenciones', 'interacciones'
          ]);
        }
      }

      // -----------------------------------------------------------------------
      // /cierres/{cierreId} — LA UNIDAD QUE SE COBRA.
      //
      // Un CIERRE es una atención de WhatsApp que TERMINÓ BIEN y quedó
      // registrada en algún lado verificable: una cita en el calendario, una
      // venta con su comprobante recibido, una fila escrita en la planilla.
      //
      // NO son cierres, y esto importa más que la definición positiva porque es
      // lo que evita cobrar de más:
      //   - mandar información y que el cliente no confirme nada;
      //   - mandar el QR y que el cliente no pague;
      //   - una conversación que quedó a medias con datos incompletos.
      // La regla práctica: si no hay un registro externo que lo pruebe, no es
      // un cierre. Por eso `referencia` es OBLIGATORIA y no puede ir vacía.
      //
      // POR QUÉ EXISTE EL DOCUMENTO Y NO SOLO EL CONTADOR. Sobre esto se
      // factura. Un número que nadie puede desglosar no se puede discutir con
      // un cliente que reclama, ni auditar cuando la cuenta no cierra.
      //
      // PRIVACIDAD. NovuChat puede leer ESTE documento para explicar una
      // factura, y por eso acá NO hay nada del contenido de la conversación ni
      // el teléfono completo: el número va enmascarado, igual que en la
      // bitácora. Lo que identifica a la persona vive en `/privado`, que solo
      // abre el administrador del negocio. Es el mismo reparto que ya usan
      // contactos y funcionarios, y la razón es la misma: las reglas no pueden
      // ocultar campos sueltos en una lectura.
      // -----------------------------------------------------------------------
      match /cierres/{cierreId} {
        allow get, list: if esMiembro(tenantId) || esPropietario();
        allow create: if esIngesta(tenantId) && tenantOperativo(tenantId) && cierreValido();
        // No se corrige ni se borra un cierre: se factura sobre esto. Un error
        // se compensa con otro asiento, no reescribiendo el original.
        allow update, delete: if false;

        function cierreValido() {
          let d = request.resource.data;
          return d.keys().hasOnly([
                   'tipo', 'ocurridoEn', 'referencia', 'telefonoEnmascarado',
                   'monto', 'moneda'
                 ])
              // `conversacionId` NO esta en la lista, y es deliberado: vale
              // `wa_<telefono>`, o sea el numero COMPLETO. Enmascarar el
              // telefono en un campo y publicarlo entero en otro no protege
              // nada. Va en /privado.
              && d.tipo in ['cita', 'venta', 'registro']
              && d.referencia is string && d.referencia.size() > 0
              && d.referencia.size() <= 200
              && d.ocurridoEn is timestamp
              // Mismo enmascarado que exige la bitácora: acá no entra un
              // teléfono completo aunque el principal de ingesta lo tenga.
              && d.telefonoEnmascarado is string
              && d.telefonoEnmascarado.matches('^[0-9]{0,4}[*]{3,}[0-9]{0,4}$');
        }

        // El detalle que identifica a la persona o al servicio. Del negocio, y
        // de nadie más: NovuChat no lo lee.
        match /privado/{documento} {
          allow get, list: if esAdmin(tenantId) && tenantLegible(tenantId);
          allow create: if esIngesta(tenantId) && tenantOperativo(tenantId);
          allow update, delete: if false;
        }
      }

      // -----------------------------------------------------------------------
      // /bitacora/{eventoId} — REGISTRO OPERATIVO. Qué se envió, a quién,
      // cuándo y con qué resultado.
      //
      // POR QUÉ ES UNA COLECCIÓN NUEVA Y NO UNA EXTENSIÓN DE /auditoria
      // ---------------------------------------------------------------
      // Las dos son inmutables y las dos son evidencia, pero responden preguntas
      // distintas y, sobre todo, CRECEN A RITMOS DISTINTOS:
      //
      //   /auditoria  «quién cambió qué». Unas pocas decenas de eventos por
      //               comercio y por año: altas, bajas, cambios de rol,
      //               suspensiones. Se lee entera de un vistazo.
      //   /bitacora   «qué hizo el sistema». Varios eventos por CADA mensaje.
      //               Miles por mes y por comercio.
      //
      // Mezclarlas tendría tres costos concretos: la pista de auditoría —que es
      // la que se mira cuando hay una disputa— quedaría ahogada en ruido de
      // entregas; cualquier consulta sobre /auditoria pasaría a costar lo que
      // cuesta recorrer la bitácora; y los índices compuestos que la bitácora
      // necesita se aplicarían también a una colección que no los usa. Además
      // piden políticas de retención distintas: la auditoría se guarda años, la
      // bitácora meses.
      //
      // QUÉ NO GUARDA, Y ESTO ES LO IMPORTANTE
      // --------------------------------------
      // **NO guarda el texto de los mensajes.** Solo metadatos: tipo, resultado,
      // código, latencia, tamaño y el teléfono ENMASCARADO.
      //
      // El motivo es de coherencia, no de espacio. Ya está decidido que el
      // propietario de NovuChat NO lee conversaciones sin una ventana de soporte
      // otorgada por el comercio (T-5). Si la bitácora llevara el texto, sería
      // una puerta trasera a exactamente eso: una colección legible por el
      // propietario, consultable entre TODOS los comercios a la vez, con el
      // contenido de las conversaciones adentro. Sería la peor versión de lo que
      // el diseño entero evita.
      //
      // Cuando hace falta el texto, la bitácora lleva `conversacionId`: con una
      // ventana de soporte vigente se salta al hilo en un clic. La regla no
      // cambia; el camino sigue siendo el mismo y sigue quedando auditado.
      //
      // QUIÉN LA LEE
      // -----------
      // El administrador del comercio y el propietario. El operador queda afuera:
      // ya tiene la vista de conversaciones, que es la misma información con más
      // contexto y acotada a los hilos. La bitácora es una lista de destinos y no
      // le agrega nada para atender.
      //
      // Se lee con `tenantLegible`: un comercio suspendido conserva su evidencia.
      // -----------------------------------------------------------------------
      match /bitacora/{eventoId} {

        allow get, list: if (esAdmin(tenantId) && tenantLegible(tenantId))
                         || esPropietario();

        // La escribe la ruta de ingesta. A diferencia de las conversaciones, se
        // admite TAMBIÉN con el comercio suspendido: la evidencia no puede tener
        // agujeros justo en el tramo más conflictivo, que es el del corte de
        // servicio. Se puede porque acá no hay contenido personal acumulándose:
        // solo metadatos y un teléfono enmascarado.
        allow create: if esIngesta(tenantId) && eventoValido();

        // INMUTABLE PARA TODOS, incluido el propietario de NovuChat. Una bitácora
        // que el proveedor puede editar no sirve como evidencia contra el
        // proveedor, que es justamente cuando más se la necesita.
        allow update, delete: if false;

        function eventoValido() {
          let d = request.resource.data;
          return d.keys().hasOnly([
                   'ts', 'tipo', 'resultado', 'canal', 'codigo',
                   'destinoEnmascarado', 'conversacionId', 'detalle',
                   'tamanoTexto', 'latenciaMs'
                 ])
            && d.get('ts', null) is timestamp
            && d.get('tipo', '') in [
                 'mensaje_entrante', 'mensaje_saliente', 'plantilla_enviada',
                 'cita_agendada', 'cita_rechazada', 'cobro_simulado',
                 'transferencia_humano', 'config_publicada', 'suspension',
                 'reactivacion', 'error_flujo', 'entrada_descartada'
               ]
            && d.get('resultado', '') in ['ok', 'fallo', 'rechazado', 'reintento']
            && d.get('canal', 'whatsapp') in ['whatsapp', 'panel', 'sistema']
            // Teléfono ENMASCARADO. El patrón exige los asteriscos: si alguien
            // intentara escribir el número completo, la regla lo rechaza. Es la
            // diferencia entre «acordarse de enmascarar» y «no poder no hacerlo».
            && (!d.keys().hasAny(['destinoEnmascarado'])
                || d.destinoEnmascarado.matches('^[0-9]{0,4}[*]{3,}[0-9]{0,4}$'))
            && textoOpc(d, 'conversacionId', 80)
            // `detalle` es un CÓDIGO CORTO de vocabulario técnico, no un lugar
            // para volcar la respuesta del proveedor ni el mensaje del cliente.
            // El tope de 120 lo hace incómodo de abusar y es deliberado.
            && textoOpc(d, 'codigo', 24)
            && textoOpc(d, 'detalle', 120)
            && (!d.keys().hasAny(['tamanoTexto'])
                || (d.tamanoTexto is int && d.tamanoTexto >= 0 && d.tamanoTexto <= 100000))
            && (!d.keys().hasAny(['latenciaMs'])
                || (d.latenciaMs is int && d.latenciaMs >= 0 && d.latenciaMs <= 600000));
        }
      }

      // -----------------------------------------------------------------------
      // /auditoria/{eventoId} — quién cambió qué y cuándo.
      // Solo escribe el SDK Admin (que se salta estas reglas por diseño).
      // Denegar la escritura acá impide que alguien fabrique o borre evidencia.
      // -----------------------------------------------------------------------
      match /auditoria/{eventoId} {
        allow get, list: if esAdmin(tenantId) || esPropietario();
        allow create, update, delete: if false;
      }

      // -----------------------------------------------------------------------
      // /accesosSoporte/{uid} — ventanas de acceso de NovuChat al negocio.
      // Las otorga una Cloud Function a pedido de un admin del negocio. Que sean
      // de solo lectura evita que el propietario se auto-conceda acceso desde el
      // navegador: tiene que pasar por la Function, que lo audita.
      // -----------------------------------------------------------------------
      match /accesosSoporte/{uid} {
        allow get, list: if esAdmin(tenantId) || esPropietario();
        allow create, update, delete: if false;
      }
    }

    // =========================================================================
    // /plataforma/{documento} — configuración de NovuChat, no de ningún comercio.
    //
    // Hoy guarda `notificaciones.correosReclamos`: a qué casillas se avisa
    // cuando entra un reclamo. Es configurable, y por eso mismo es delicado.
    //
    // POR QUÉ NADIE LO ESCRIBE DESDE EL NAVEGADOR. Esta lista es el DESTINO de
    // un correo que lleva texto escrito por un usuario. Si alguien pudiera
    // agregarle una dirección, convertiría el sistema en un reenviador: escribe
    // un reclamo con lo que quiera y lo hace salir, firmado por NovuChat, hacia
    // donde quiera. La escribe solo una Cloud Function, y la Function que envía
    // el correo la lee con el SDK Admin. El destino NUNCA sale del reclamo.
    // =========================================================================
    match /plataforma/{documento} {
      allow get, list: if esPropietario();
      allow create, update, delete: if false;
    }

    // =========================================================================
    // CONSULTA DE GRUPO DE COLECCIONES SOBRE LA BITÁCORA
    //
    // ⚠️ TRAMPA DE FIRESTORE QUE COSTÓ UN RATO ENCONTRAR. Una consulta de grupo
    // (`collectionGroup('bitacora')`) **NO la autoriza la regla anidada en
    // `/tenants/{tenantId}/bitacora`**. Firestore la evalúa contra un patrón
    // distinto, y hace falta una regla con comodín recursivo. Sin esto, la
    // pantalla de plataforma falla con «Missing or insufficient permissions»
    // aunque el propietario tenga permiso documento por documento.
    //
    // No lo detectó ninguna de las 137 pruebas anteriores: apareció al abrir la
    // pantalla. Ahora hay tres pruebas que lo cubren.
    //
    // POR QUÉ ESTÁ ACOTADO AL PROPIETARIO. Una consulta de grupo SE SALTEA LA
    // RUTA, que es donde vive todo el aislamiento de este diseño. Si un comercio
    // pudiera hacerla, leería la bitácora de todos. Por eso el comodín admite
    // únicamente a `esPropietario()`, y no otorga nada nuevo: el propietario ya
    // podía leer cada bitácora por la regla anidada.
    //
    // POR QUÉ SOLO PARA LA BITÁCORA. Es la única colección sin contenido
    // personal —solo metadatos y teléfonos enmascarados—. Un comodín equivalente
    // sobre `conversaciones` o `mensajes` sería exactamente la puerta trasera a
    // T-5 que el diseño entero evita. Hay una prueba que lo verifica.
    // =========================================================================
    match /{ruta=**}/bitacora/{eventoId} {
      allow list: if esPropietario();
    }

    // =========================================================================
    // /rutasWhatsApp/{phoneNumberId} — ÍNDICE INVERSO NÚMERO → COMERCIO.
    //
    // POR QUÉ EXISTE
    // --------------
    // El webhook de Meta no trae el identificador del comercio: trae
    // `entry[0].changes[0].value.metadata.phone_number_id`. Con varios flujos
    // (agendamiento, venta y cobro, interno) y un número por comercio, n8n
    // necesita resolver ese número a un tenant y a un flujo antes de hacer
    // cualquier otra cosa.
    //
    // POR QUÉ UNA COLECCIÓN Y NO UNA CONSULTA SOBRE /tenants
    // ------------------------------------------------------
    // Un `where('waPhoneNumberId','==',id)` sobre /tenants exigiría permiso de
    // listado sobre la cartera entera de clientes —justo lo que T-12 prohíbe— y
    // además un índice compuesto. Acá el identificador del número ES la clave
    // del documento: la resolución es una lectura directa, sin índice y sin
    // abrir ningún listado.
    //
    // QUIÉN ENTRA
    // -----------
    // Nadie desde el navegador salvo el propietario de NovuChat. n8n NO lee esta
    // colección: la consulta la hace la Cloud Function con el SDK Admin, después
    // de validar la firma HMAC. Que un comercio pudiera leerla le diría con qué
    // números operan los demás.
    //
    // Documento: { tenantId, flujo, wabaId, estado }
    // =========================================================================
    match /rutasWhatsApp/{phoneNumberId} {
      allow get, list: if esPropietario();
      // La escribe únicamente la Function `asignarNumero`, que además garantiza
      // que un mismo phone_number_id no apunte nunca a dos comercios.
      allow create, update, delete: if false;
    }

    // =========================================================================
    // /usuarios/{uid} — perfil propio. NO contiene roles: los roles son claims.
    // =========================================================================
    match /usuarios/{uid} {
      allow get: if autenticado() && (request.auth.uid == uid || esPropietario());
      allow list: if esPropietario();

      // El usuario edita su propio nombre y preferencias, nada más. La lista
      // blanca de campos es lo que impide la escalada de privilegios clásica:
      // el usuario agregándose a sí mismo un campo `rol: "admin"` con la
      // esperanza de que alguna pantalla lo tome como autorización.
      allow update: if autenticado()
                    && request.auth.uid == uid
                    && soloCampos(['nombre', 'preferencias'])
                    && textoOpc(request.resource.data, 'nombre', 120);
      allow create, delete: if false;
    }

    // =========================================================================
    // NEGACIÓN FINAL. Todo lo que no coincidió con una regla de arriba queda
    // prohibido: colecciones nuevas, rutas mal escritas, experimentos olvidados.
    // Esta regla es la red de seguridad del diseño entero. No borrarla.
    // =========================================================================
    match /{documento=**} {
      allow read, write: if false;
    }
  }
}
