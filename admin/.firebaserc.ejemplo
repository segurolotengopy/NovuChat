{
  "projects": {
    "default": "${GCP_PROJECT_ID_STAGING}",
    "staging": "${GCP_PROJECT_ID_STAGING}",
    "prod": "${GCP_PROJECT_ID}"
  },
  "targets": {
    "${GCP_PROJECT_ID_STAGING}": {
      "hosting": {
        "consola": ["${GCP_PROJECT_ID_STAGING}"],
        "catalogo": ["${HOSTING_SITIO_CATALOGO_STAGING}"]
      }
    },
    "${GCP_PROJECT_ID}": {
      "hosting": {
        "consola": ["${HOSTING_SITIO_CONSOLA}"],
        "catalogo": ["${HOSTING_SITIO_CATALOGO}"]
      }
    }
  }
}
