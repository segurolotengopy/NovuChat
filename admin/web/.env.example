# Configuración pública del cliente Firebase.
# NO son secretos: viajan en el bundle del navegador y así lo documenta Google.
# Lo que protege los datos son las reglas de Firestore y App Check, nunca esto.
# Copie a `.env.local` (ignorado por git) para desarrollo.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Clave de sitio de reCAPTCHA Enterprise para App Check (tampoco es secreta).
VITE_APPCHECK_SITE_KEY=
# Solo en desarrollo: apunta el SDK a los emuladores.
VITE_USAR_EMULADORES=false
