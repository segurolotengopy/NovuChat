{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./CONFIGURACION.local.md)",
      "Read(./**/serviceAccountKey*.json)",
      "Read(./**/client_secret*.json)",
      "Read(~/.ssh/**)",
      "Read(~/.config/gh/**)",
      "Bash(./deploy.sh prod*)",
      "Bash(./deploy.sh production*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(gh repo edit*)",
      "Bash(gh pr review*)",
      "Bash(gh release create*)",
      "Bash(gh secret set*)",
      "Bash(gh auth token*)",
      "Bash(git tag*)",
      "Bash(curl:*)",
      "Bash(wget:*)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(gh *)",
      "Bash(npm publish*)",
      "Bash(firebase deploy*)"
    ]
  }
}
