      "parameters": {
        "method": "GET",
        "url": "=https://graph.facebook.com/{{ $('Config base').first().json.waGraphVersion }}/{{ $('Config base').first().json.phoneNumberIdB }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "whatsAppApi",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
