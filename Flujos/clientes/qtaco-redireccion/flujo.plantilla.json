{
  "name": "@@dato:nombreFlujo@@",
  "settings": {
    "executionOrder": "v1",
    "timezone": "America/La_Paz",
    "executionTimeout": 60,
    "saveDataSuccessExecution": "none",
    "saveDataErrorExecution": "all",
    "saveExecutionProgress": false,
    "saveManualExecutions": false
  },
  "nodes": [
    {
      "id": "entrega-receptor", "name": "Entrega del receptor", "type": "n8n-nodes-base.webhook", "typeVersion": 2, "position": [0, 300],
      "parameters": { "httpMethod": "POST", "path": "@@dato:receptor.ruta@@", "responseMode": "responseNode", "options": {} },
      "notes": "Entrega firmada del receptor de clientes. La ruta es una URL de capacidad: va como marcador REEMPLAZAR_* y la resuelve preparar-import.sh. Plan A: la ruta viva de Q'Taco (publicar-flujo.sh conserva el webhookId vivo por el nombre del nodo). Plan B: ruta nueva (qtaco-ruta-nueva.json)."
    },
    {
      "id": "verificar-firma", "name": "Verificar firma con el receptor", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [240, 300],
      "parameters": {
        "method": "POST", "url": "@@dato:receptor.urlVerificador@@", "sendBody": true, "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ firma: $json.headers['x-aab1-signature'] ?? '', timestamp: $json.headers['x-aab1-timestamp'] ?? '', deliveryId: $json.headers['x-aab1-delivery-id'] ?? '', cuerpo: JSON.stringify($json.body), wabaIdEsperado: \"@@dato:receptor.wabaIdEsperado@@\" }) }}",
        "options": { "timeout": 10000 }
      },
      "notes": "SIN «Continue on Fail» ni onError, a propósito: un 503 del verificador debe reintentarse, no convertirse en 401. wabaIdEsperado va fijo (WABA de la línea vieja). Solo por la red interna."
    },
    {
      "id": "firma-valida", "name": "¿Firma válida?", "type": "n8n-nodes-base.if", "typeVersion": 2.2, "position": [480, 300],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 2 },
          "conditions": [ { "id": "firma-valida", "leftValue": "={{ $json.valido }}", "rightValue": "", "operator": { "type": "boolean", "operation": "true", "singleValue": true } } ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "aceptar-200", "name": "Aceptar (200)", "type": "n8n-nodes-base.respondToWebhook", "typeVersion": 1.4, "position": [720, 200],
      "parameters": { "respondWith": "noData", "options": { "responseCode": 200 } }
    },
    {
      "id": "rechazar-401", "name": "Rechazar (401)", "type": "n8n-nodes-base.respondToWebhook", "typeVersion": 1.4, "position": [720, 420],
      "parameters": { "respondWith": "noData", "options": { "responseCode": 401 } },
      "notes": "Firma inválida o evento de otra WABA: corta aquí, 0 mensajes."
    },
    {
      "id": "descartar-repetidos", "name": "Descartar repetidos", "type": "n8n-nodes-base.removeDuplicates", "typeVersion": 2, "position": [960, 200],
      "parameters": {
        "operation": "removeItemsSeenInPreviousExecutions", "logic": "removeItemsWithAlreadySeenKeyValues",
        "dedupeValue": "={{ $('Verificar firma con el receptor').item.json.deliveryId }}", "options": {}
      },
      "notes": "Descarta una entrega ya vista (el receptor reintenta) entre ejecuciones, por deliveryId."
    },
    {
      "id": "config-del-negocio", "name": "Config del negocio", "type": "n8n-nodes-base.set", "typeVersion": 3.4, "position": [1200, 200],
      "parameters": { "assignments": { "assignments": [] }, "includeOtherFields": true, "options": {} },
      "notes": "LO CONFIGURABLE: el texto del aviso, el número nuevo, la ventana y el phone_number_id de la línea vieja. Se llena desde admin/scripts/datos/qtaco-redireccion/qtaco.json (nunca a mano en n8n)."
    },
    {
      "id": "decidir-aviso", "name": "Decidir aviso", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [1440, 200],
      "parameters": { "mode": "runOnceForAllItems", "language": "javaScript", "jsCode": "@@nodos/decidir-aviso.js@@" }
    },
    {
      "id": "avisar", "name": "¿Avisar?", "type": "n8n-nodes-base.if", "typeVersion": 2.2, "position": [1680, 200],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 2 },
          "conditions": [ { "id": "avisar", "leftValue": "={{ $json.avisar }}", "rightValue": "", "operator": { "type": "boolean", "operation": "true", "singleValue": true } } ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "enviar-aviso", "name": "Enviar aviso", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [1920, 120],
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/{{ $json.waGraphVersion || 'v26.0' }}/{{ $json.phoneNumberId }}/messages",
        "authentication": "genericCredentialType", "genericAuthType": "httpHeaderAuth",
        "sendBody": true, "specifyBody": "json", "jsonBody": "={{ JSON.stringify($json.payload) }}",
        "options": { "timeout": 15000, "batching": { "batch": { "batchSize": 1, "batchInterval": 1000 } } }
      },
      "credentials": { "httpHeaderAuth": { "id": "", "name": "@@cred:graph" } },
      "onError": "continueRegularOutput",
      "alwaysOutputData": true,
      "notes": "Un solo texto de servicio por cliente y ventana. Sin reintentos automáticos. Si Meta no devuelve un id, «Marcar avisado» no lo marca y la ejecución termina en error."
    },
    {
      "id": "marcar-avisado", "name": "Marcar avisado", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [2160, 120],
      "parameters": { "mode": "runOnceForAllItems", "language": "javaScript", "jsCode": "@@nodos/marcar-avisado.js@@" }
    }
  ],
  "connections": {
    "Entrega del receptor": { "main": [[{ "node": "Verificar firma con el receptor", "type": "main", "index": 0 }]] },
    "Verificar firma con el receptor": { "main": [[{ "node": "¿Firma válida?", "type": "main", "index": 0 }]] },
    "¿Firma válida?": { "main": [[{ "node": "Aceptar (200)", "type": "main", "index": 0 }], [{ "node": "Rechazar (401)", "type": "main", "index": 0 }]] },
    "Aceptar (200)": { "main": [[{ "node": "Descartar repetidos", "type": "main", "index": 0 }]] },
    "Descartar repetidos": { "main": [[{ "node": "Config del negocio", "type": "main", "index": 0 }]] },
    "Config del negocio": { "main": [[{ "node": "Decidir aviso", "type": "main", "index": 0 }]] },
    "Decidir aviso": { "main": [[{ "node": "¿Avisar?", "type": "main", "index": 0 }]] },
    "¿Avisar?": { "main": [[{ "node": "Enviar aviso", "type": "main", "index": 0 }], []] },
    "Enviar aviso": { "main": [[{ "node": "Marcar avisado", "type": "main", "index": 0 }]] }
  }
}
